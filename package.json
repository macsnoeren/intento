{
  "name": "intento",
  "version": "0.1.0",
  "private": true,
  "description": "AI-ondersteunde AAC-communicatieapplicatie",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "overrides": {
    "@prisma/dev": "^0.24.14",
    "deepmerge-ts": "^8.0.2"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "concurrently --raw \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "stop": "bash scripts/stop.sh",
    "docker:build": "docker compose --env-file .env.docker build",
    "docker:up": "docker compose --env-file .env.docker up -d",
    "docker:down": "docker compose --env-file .env.docker --profile ai down",
    "docker:logs": "docker compose --env-file .env.docker --profile ai logs -f",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
