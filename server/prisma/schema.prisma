// Prisma-schema voor Intento (DESIGN §6, §9.3).
//
// Bron van waarheid voor het relationele datamodel. DB-wijzigingen lopen ALTIJD via
// migraties (`npm run db:migrate`), nooit ad-hoc — zie CLAUDE.md kernprincipe 9.
//
// Portabiliteit: dev draait op SQLite, productie op PostgreSQL. Het schema blijft
// bewust PostgreSQL-compatibel: geen SQLite-only constructies en geen native enums
// (SQLite kent die niet) — categorie-/type-velden zijn `String` met de toegestane
// waarden in commentaar en worden op de grens met zod gevalideerd. Zie ADR-0003 en
// docs/data-model.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  // Dev/test: SQLite. Prod: zet dit op "postgresql" (ADR-0003). De verbinding zelf
  // staat niet meer in het schema (Prisma 7) maar in prisma.config.ts (CLI) en de
  // driver adapter in src/db/prisma.ts (runtime).
  provider = "sqlite"
}

/// Een Intento-omgeving (zorginstelling, familie of persoonlijk). Tenant-root: vrijwel
/// alle latere entiteiten hangen hieronder en elke query wordt op `organizationId`
/// gefilterd (multi-tenant-isolatie, DESIGN §9.4). Het eerste fundament-model in T0.2;
/// accounts, gebruikers en de rest volgen in latere taken.
model Organization {
  id        String   @id @default(cuid())
  /// Weergavenaam van de omgeving.
  name      String
  /// Soort omgeving: "family" | "care" | "personal" (gevalideerd op de API-grens).
  type      String
  /// Platform-/operatororganisatie (T5.8): alléén ADMINs van zo'n org mogen platform-brede
  /// infrastructuur beheren (worker-tokens). Standaard `false`; de bootstrap-seed zet dit op
  /// `true` en publieke zelfaanmelding (T1.3) nooit. Zo kan een zelf-aangemelde familie/zorg-
  /// admin geen infra-credentials munten die jobs van álle tenants zouden verwerken (DESIGN §9.4).
  isPlatform Boolean @default(false)
  /// Of de omgeving actief is (T8.3). Een platform-operator kan een organisatie **deactiveren** om
  /// misbruik te stoppen: dat is bewust geen verwijdering (gegevens blijven staan, herstel is één
  /// klik) maar wel een harde stop — inloggen, bestaande accountsessies én gekoppelde tablets van
  /// een inactieve organisatie worden geweigerd (`ORGANIZATION_SUSPENDED`). Zie docs/security.md.
  active     Boolean @default(true)
  createdAt  DateTime @default(now())

  accounts Account[]
  users    User[]
}

/// De communicerende persoon (DESIGN §2, §6.2). Staat bewust los van `Account`: een
/// gebruiker hoeft geen eigen login te hebben (bediening kan via een gekoppelde tablet of
/// een begeleider), en één persoon is niet per se één login. `active` maakt het mogelijk een
/// gebruiker te deactiveren zonder gegevens te verwijderen. Tenant-gebonden via
/// `organizationId`: elke query wordt hierop gefilterd (multi-tenant-isolatie, DESIGN §9.4).
model User {
  id             String   @id @default(cuid())
  /// Weergavenaam van de persoon.
  name           String
  organizationId String
  /// Of de gebruiker actief is; inactief = behouden maar niet in gebruik.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 1-op-1 communicatie-instellingen; verdwijnt mee als de gebruiker wordt verwijderd.
  communicationProfile UserCommunicationProfile?
  /// Gekoppelde begeleiders (CAREGIVER-accounts) die deze gebruiker mogen helpen.
  caregiverLinks       CaregiverAssignment[]
  /// Gekoppelde apparaten (tablets) die als deze gebruiker in de gebruikersapp starten.
  devices              Device[]
  /// Openstaande/gebruikte koppelcodes waarmee een apparaat aan deze gebruiker koppelt.
  deviceLinkCodes      DeviceLinkCode[]
  /// Gespreksessies van deze gebruiker (T4.1); verdwijnen mee als de gebruiker wordt verwijderd.
  conversationSessions ConversationSession[]
  /// Persoonlijke context van deze gebruiker (T6.1); gevoelige velden versleuteld at-rest.
  personalContexts     PersonalContext[]
  /// Geleerde voorkeuren (T6.3); alléén uit bevestigde communicatie, uitschakelbaar per gebruiker.
  preferences          Preference[]

  @@index([organizationId])
}

/// Persoonlijke context van een gebruiker: belangrijke personen, huisdieren, plekken, favorieten,
/// routines (T6.1, DESIGN §3.7 stap 3, §6.2 PersonalContext, §6.3, §9.4, FR-013/020). Dient om de AI
/// te personaliseren — maar **alléén met expliciete toestemming**: alleen rijen met `aiUsageAllowed=true`
/// belanden ooit in het AI-contextobject (DESIGN §6.3). Privacy by design:
///
/// - **Versleuteld at-rest.** De gevoelige, vrij-tekst PII-velden (`name`, `relationship`) staan NOOIT
///   plaintext in de db: ze worden met AES-256-GCM versleuteld (`ENCRYPTION_KEY`) opgeslagen als
///   ondoorzichtige strings (`nameEncrypted`, `relationshipEncrypted`) en pas op de API-grens ontsleuteld.
///   Zo levert db-lekkage geen leesbare persoonsgegevens op (DESIGN §9.4, CLAUDE.md security-checklist).
/// - **Toestemming per rij.** `aiUsageAllowed` (standaard `false` — opt-in) bepaalt of de AI deze context
///   mag zien. Zonder toestemming blijft de context zichtbaar voor beheer/begeleiding maar bereikt hij de
///   prompt nooit.
/// - **Tenant-/gebruiker-gebonden.** Aan precies één `User` gebonden; elke query wordt op de gebruiker
///   (en via de gebruiker op de organisatie) gefilterd (multi-tenant-isolatie, DESIGN §9.4).
///
/// `category` is een gesloten taxonomie (PERSON/PET/PLACE/ACTIVITY/FOOD/OBJECT/ROUTINE/OTHER), op de grens
/// met zod gevalideerd — geen native enum i.v.m. SQLite/PostgreSQL-portabiliteit (zie schema-header).
model PersonalContext {
  id                    String   @id @default(cuid())
  userId                String
  /// Categorie: "PERSON" | "PET" | "PLACE" | "ACTIVITY" | "FOOD" | "OBJECT" | "ROUTINE" | "OTHER"
  /// (gevalideerd op de API-grens). Bepaalt hoe de context de AI ondersteunt.
  category              String
  /// AES-256-GCM-cijfertekst van de naam/omschrijving (bv. een persoons- of huisdiernaam). Nooit plaintext.
  nameEncrypted         String
  /// AES-256-GCM-cijfertekst van de relatie/toelichting (bv. "dochter"); `null` als niet opgegeven.
  relationshipEncrypted String?
  /// Of de AI deze context mag gebruiken (DESIGN §6.3). Standaard `false` (opt-in, expliciete toestemming).
  aiUsageAllowed        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Communicatie-instellingen per gebruiker (DESIGN §5.3, §6.2). 1-op-1 aan `User`
/// (`userId` is de primaire sleutel). De waarden sturen de gebruikersapp aan:
/// - `iconsPerScreen`: aantal opties per scherm — alleen 2/4/6/8 (standaard 4), afgedwongen
///   met zod op de API-grens (geen native enum i.v.m. SQLite/PostgreSQL-portabiliteit).
/// - `showText`: tekst onder pictogrammen tonen (ondersteunend, standaard aan).
/// - `aiLearningEnabled`: leren van bevestigde communicatie toestaan (uitschakelbaar).
/// - `supportMode`: ondersteuningsmodus (begeleider tikt aan namens de gebruiker).
/// - `contextIndicator`: contextindicator (broodkruimel van het afgelegde pad) in de
///   gebruikersapp tonen (DESIGN §5.3, standaard aan).
/// - `conversationStrategy`: de gespreksstrategie van deze persoon (T11.4, DESIGN §7.10) — de
///   manier waarop de AI probeert te achterhalen wat hij bedoelt. De strategieën zijn
///   **ingebouwd** (code, stabiele sleutel); hier staat alleen de gekozen sleutel, op de
///   API-grens met zod tegen de registry gevalideerd. Standaard `refine`: bestaande
///   gebruikers houden daarmee exact het gedrag van vóór deze instelling.
model UserCommunicationProfile {
  userId               String  @id
  iconsPerScreen       Int     @default(4)
  showText             Boolean @default(true)
  aiLearningEnabled    Boolean @default(true)
  supportMode          Boolean @default(false)
  contextIndicator     Boolean @default(true)
  conversationStrategy String  @default("refine")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Een login voor een persoon met toegang tot een organisatie (DESIGN §2, §6.2). De rol
/// bepaalt wat het account mag (ADMIN/CAREGIVER/USER). Wachtwoorden worden nooit
/// plaintext opgeslagen — alleen een argon2id-hash. `email` is platformbreed uniek zodat
/// login op e-mail alleen het account eenduidig bepaalt (MVP-keuze, zie ADR-0004).
model Account {
  id             String   @id @default(cuid())
  /// Login-identiteit; platformbreed uniek (lowercase genormaliseerd op de API-grens).
  email          String   @unique
  /// Weergavenaam van de accounthouder (bv. de admin die zich zelf aanmeldde, T1.3).
  /// Nullable: geseede/bestaande accounts hebben geen naam en login vereist er geen.
  name           String?
  /// argon2id-hash van het wachtwoord. Nooit het wachtwoord zelf.
  passwordHash   String
  /// Rol: "ADMIN" | "CAREGIVER" | "USER" (gevalideerd op de API-grens; geen native enum
  /// i.v.m. PostgreSQL/SQLite-portabiliteit, zie schema-header en ADR-0003).
  role           String
  organizationId String
  /// Account-lockout tegen brute force: telt opeenvolgende mislukte logins; `lockedUntil`
  /// blokkeert login tot dat moment. Beide worden bij een geslaagde login gereset.
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  /// E-mailverificatie (T1.4, DESIGN §2, §9.4). `null` = nog niet geverifieerd; anders het moment
  /// waarop het e-mailadres via een verificatietoken is bevestigd. Onbevestigde accounts mogen
  /// inloggen maar bepaalde gevoelige acties (bv. gebruikers aanmaken) zijn geblokkeerd tot
  /// verificatie — zie docs/security.md. Geseede/bestaande accounts (vóór T1.4) blijven `null`.
  emailVerifiedAt DateTime?
  /// Tijdelijk-wachtwoord-markering (T2.6, DESIGN §2, §9.4). `true` zolang dit account nog draait op
  /// het **server-gegenereerde** wachtwoord dat een beheerder bij het aanmaken (T2.4) te zien kreeg:
  /// dat wachtwoord is dus bij een tweede persoon bekend en het account is tot die tijd niet echt van
  /// de houder alleen. Gezet bij `createCaregiverAccount`, gewist zodra de houder zelf via
  /// `POST /auth/password` (T2.5) een eigen wachtwoord kiest. Zolang de vlag staat laat `authorize()`
  /// alléén het eigen account bekijken en het wachtwoord wijzigen toe (`403 PASSWORD_CHANGE_REQUIRED`
  /// op al het overige) — zie docs/security.md. Standaard `false`: zelf gekozen wachtwoorden
  /// (zelfaanmelding T1.3, seed) zijn nooit bij een ander bekend.
  mustChangePassword Boolean @default(false)
  /// Platform-operator (T8.3, DESIGN §9.1, §9.4). `true` = dit account mag de operatorconsole
  /// gebruiken: organisaties en accounts **over tenants heen** inzien en beheren. Bewust een aparte
  /// vlag naast `role`, niet een vierde rol: de rol bepaalt wat je binnen je eigen organisatie mag
  /// (en blijft overal tenant-gefilterd), terwijl deze vlag een tweede, expliciet gescheiden
  /// bevoegdheid ontgrendelt op een eigen `/operator`-routetak met een eigen guard. De vlag telt
  /// alléén binnen een organisatie met `isPlatform=true` (dubbele voorwaarde) en wordt uitsluitend
  /// door de bootstrap-seed gezet — nooit via een API. Zie ADR-0011 en docs/security.md.
  isOperator     Boolean @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]
  /// Gebruikers waaraan dit account (als CAREGIVER) gekoppeld is.
  caregiverLinks CaregiverAssignment[]
  /// Openstaande/gebruikte e-mailverificatietokens van dit account.
  emailVerificationTokens EmailVerificationToken[]

  @@index([organizationId])
}

/// Een e-mailverificatietoken (T1.4, DESIGN §2, §9.4). Wordt bij zelfaanmelding (T1.3) en bij
/// `resend` aangemaakt en per e-mail als **rauwe** token naar de accounthouder gestuurd. Net als
/// sessie- en apparaat-tokens staat het token NOOIT plaintext in de db — alleen de SHA-256-hash
/// (`tokenHash`). Bij inwisselen (`/auth/verify-email`) hashen we het aangeboden token en zoeken
/// hierop. Tokens zijn **eenmalig** (`usedAt` gezet zodra ingewisseld) en **verlopen** (`expiresAt`);
/// een verlopen of gebruikt token wordt geweigerd. `onDelete: Cascade` ruimt tokens op als het
/// account verdwijnt.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  /// SHA-256-hash (hex) van het verificatietoken. Uniek zodat inwisselen direct op de hash zoekt.
  tokenHash String    @unique
  accountId String
  /// Moment van inwisselen; `null` zolang ongebruikt. Eenmalig gebruik wordt hierop bewaakt.
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Koppeling tussen een begeleider (CAREGIVER-`Account`) en een `User` (T2.2, DESIGN §2,
/// FR-017). Een begeleider ziet en beheert **alleen** de gebruikers waaraan hij expliciet
/// gekoppeld is; zonder koppeling geeft toegang tot die gebruiker 403. De koppeling is een
/// many-to-many tussen account en gebruiker; de tenant-grens (zelfde organisatie) wordt op
/// de API-grens bewaakt. De samengestelde sleutel voorkomt dubbele koppelingen, en beide
/// kanten `onDelete: Cascade` ruimen de koppeling op als het account of de gebruiker verdwijnt.
model CaregiverAssignment {
  userId    String
  accountId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
}

/// Een gekoppelde tablet (DESIGN §6.2, FR-018, T2.3). Een apparaat is aan **precies één**
/// `User` gebonden en start daarna direct in de gebruikersapp zonder dagelijkse login. Net als
/// bij sessies staat het apparaat-token NOOIT plaintext in de db — alleen de SHA-256-hash
/// (`tokenHash`). De client krijgt het rauwe token als langlevende httpOnly+Secure cookie; bij
/// elke request hashen we de cookie en zoeken hierop. Het token geeft alléén toegang tot de
/// eigen-gebruiker-endpoints (device-scope), nooit tot beheer- of accountroutes. `lastActive`
/// legt het laatste gebruik vast (monitoring, DESIGN §9.4 — geen communicatie-inhoud).
model Device {
  id         String   @id @default(cuid())
  userId     String
  /// Soort apparaat, bv. "tablet" (gevalideerd op de API-grens; geen native enum i.v.m.
  /// SQLite/PostgreSQL-portabiliteit, zie schema-header).
  type       String   @default("tablet")
  /// SHA-256-hash (hex) van het langlevende apparaat-token. Uniek zodat lookup direct raakt.
  tokenHash  String   @unique
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Een koppelcode die een beheerder genereert om een tablet aan een gebruiker te koppelen
/// (DESIGN §3.7 stap 5, FR-018, T2.3). De code wisselt op `POST /devices/link` in voor een
/// apparaat-token. Beveiliging: de code staat **gehasht** at-rest (`codeHash`, SHA-256) — net
/// als tokens lekt de db geen bruikbare codes. Codes zijn **eenmalig** (`usedAt` gezet zodra
/// ingewisseld) en **verlopen** (`expiresAt`); een verlopen of gebruikte code wordt geweigerd.
model DeviceLinkCode {
  id        String    @id @default(cuid())
  /// SHA-256-hash (hex) van de koppelcode. Uniek zodat inwisselen direct op de hash zoekt.
  codeHash  String    @unique
  userId    String
  /// Moment van inwisselen; `null` zolang ongebruikt. Eenmalig gebruik wordt hierop bewaakt.
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Een pictogram uit de beheerde AAC-bibliotheek (DESIGN §6.2, FR-015, T3.1). De bibliotheek
/// begrenst de AI: tijdens communicatie mag alleen uit deze symbolen worden gekozen (DESIGN §7.6).
/// Ze zijn **platformbreed gedeeld**, niet tenant-gebonden — één beheerde woordenschat voor alle
/// omgevingen (persoonlijke context/voorkeuren blijven wél per gebruiker en tenant).
///
/// Velden:
/// - `concept`: canonieke, unieke conceptsleutel (lowercase, bv. "walking"). Hiernaar verwijzen
///   relaties en straks de AI-context (§6.3); niet de weergavetekst.
/// - `label`: weergavetekst voor de gebruiker (Nederlands, bv. "Wandelen").
/// - `category`: categoriesleutel ("intent" | "activity" | ... ; gevalideerd op de API-grens,
///   geen native enum i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header).
/// - `glyph`: de visuele weergave als emoji-fallback. Zolang er geen afbeelding is geüpload rendert
///   de server hieruit een SVG-placeholder (`GET /aac/images/:id`). Beheerders beheren dit in T3.2.
/// - `imageData` / `imageMimeType`: een door een beheerder geüpload pictogram (T3.2). Bewust **in de
///   db** opgeslagen (Bytes) i.p.v. op het bestandssysteem: portabel op SQLite én PostgreSQL, één
///   backup-/migratiepad en geen pad-/serving-beveiliging op schijf. Beide `null` = nog geen upload,
///   dan valt serving terug op de glyph-placeholder. Alleen een mime-allowlist (raster) wordt
///   geaccepteerd, met groottelimiet (zie env `AAC_IMAGE_MAX_BYTES`).
/// - `imageVersion`: teller die bij elke upload omhooggaat en als cache-buster (`?v=`) in de
///   afbeeldings-URL komt, zodat een vervangen pictogram niet uit de browsercache blijft komen.
/// - `synonyms`: alternatieve zoektermen (JSON-array van strings) — gestructureerd bewaard zodat de
///   beheer-UI ze los kan beheren en de zoek-API ze kan teruggeven.
/// - `searchText`: afgeleide, genormaliseerde (lowercase) zoekindex = concept + label + synoniemen.
///   De zoek-API matcht hierop met één `contains`, wat **portabel én hoofdletterongevoelig** is op
///   zowel SQLite als PostgreSQL (beide kanten vooraf lowercase → geen DB-specifieke `mode` nodig).
///   Wordt herbouwd bij elke wijziging van het symbool of zijn synoniemen.
model AacSymbol {
  id            String   @id @default(cuid())
  concept       String   @unique
  label         String
  category      String
  glyph         String
  /// Geüploade afbeeldingsbytes (T3.2); `null` = terugvallen op de glyph-placeholder.
  imageData     Bytes?
  /// Mime-type van de geüploade afbeelding (uit de mime-allowlist); `null` als er geen upload is.
  imageMimeType String?
  /// Cache-buster: telt uploads, komt als `?v=` in de afbeeldings-URL.
  imageVersion  Int      @default(0)
  /// Bronvermelding/licentie van een gekoppelde externe afbeelding (OpenSymbols, T3.3). Alle `null`
  /// bij een zelf-geüploade afbeelding of de glyph-placeholder. Reist mee met het pictogram zodat de
  /// licentie-attributie altijd zichtbaar is (CC-attributie: auteur + bron + licentie).
  imageLicense    String?
  imageLicenseUrl String?
  imageAuthor     String?
  imageAuthorUrl  String?
  imageSourceUrl  String?
  /// JSON-array van synoniemen (zoektermen). Op de grens met zod gevalideerd/geparseerd.
  synonyms      Json
  /// Genormaliseerde zoekindex (lowercase); afgeleid, nooit rechtstreeks aan de client getoond.
  searchText    String
  /// Herkomst van het symbool (T10.6, DESIGN §7.6 trap 3): "library" (seed of door een beheerder
  /// toegevoegd) of "ai" (tijdens een gesprek door de AI aangedragen omdat het begrip nog niet bestond).
  /// Op de API-grens gevalideerd; geen native enum i.v.m. SQLite/PostgreSQL-portabiliteit.
  origin        String   @default("library")
  /// Beoordelingsstatus van een AI-gegenereerd symbool: "APPROVED" (bibliotheek, standaard) of
  /// "PENDING" (nieuw, nog niet door een beheerder bekeken). Een PENDING-symbool doet gewoon mee in het
  /// gesprek — dat is de hele bedoeling — maar wordt in de UI **zichtbaar gemarkeerd** als nieuw woord
  /// en staat in de beheerlijst (T10.7). De gebruiker blijft eigenaar: hij kiest het zelf (DESIGN §7.8).
  reviewStatus  String   @default("APPROVED")
  createdAt     DateTime @default(now())

  /// Relaties waarin dit symbool de ouder is (bv. "buiten" bevat "wandelen").
  parentLinks AacConceptRelation[] @relation("parent")
  /// Relaties waarin dit symbool het kind is.
  childLinks  AacConceptRelation[] @relation("child")

  @@index([category])
  @@index([reviewStatus])
}

/// Een begripsrelatie tussen twee AAC-symbolen (DESIGN §6.2, FR-015, T3.1). Vormt de boom waarlangs
/// de (later AI-gestuurde) verfijning loopt: van intentie naar steeds concreter concept
/// (bv. "buiten" → "wandelen"). `relation` typeert de relatie ("contains" in de MVP; ruimte voor
/// meer types later). De samengestelde unieke sleutel voorkomt dubbele relaties; beide kanten
/// `onDelete: Cascade` ruimen de relatie op als een van de symbolen verdwijnt.
model AacConceptRelation {
  id       String @id @default(cuid())
  parentId String
  childId  String
  /// Type relatie: "contains" | … (gevalideerd op de API-grens; geen native enum i.v.m.
  /// SQLite/PostgreSQL-portabiliteit — zie schema-header).
  relation String @default("contains")

  parent AacSymbol @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  child  AacSymbol @relation("child", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, relation])
  @@index([parentId])
  @@index([childId])
}

/// Een gespreksessie: het tijdelijke communicatieproces waarin een gebruiker via pictogramkeuzes
/// zijn intentie opbouwt (T4.1, DESIGN §3.1, §6.2). De sessie is aan **precies één** `User` gebonden
/// (gebruiker-isolatie, DESIGN §9.4): een tablet mag alleen de sessies van zijn eigen gebruiker zien.
/// In deze fase draait de vraagselectie op een **gescripte engine** over de AAC-relatieboom; de
/// AI-orchestrator neemt die rol later over achter dezelfde interface. Alleen bevestigde communicatie
/// wordt uiteindelijk bewaard (DESIGN §3.6) — het genereren/bevestigen volgt in T4.3.
model ConversationSession {
  id        String   @id @default(cuid())
  userId    String
  /// Status: "ACTIVE" | "COMPLETED" | "ABANDONED" (gevalideerd op de API-grens; geen native enum
  /// i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header). In T4.1 alleen ACTIVE; T4.3 rondt af.
  status    String   @default("ACTIVE")
  /// Gespreksmodus: "free" (gebruiker start zelf een vrij gesprek, T4.1) of "question" (een begeleider
  /// stelde een vraag via de vraagmodus, T7.1, DESIGN §3.2). Op de API-grens gevalideerd; geen native
  /// enum i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header.
  mode      String   @default("free")
  /// De letterlijke begeleidersvraag bij een vraagmodus-sessie ("Wat wil je drinken?", DESIGN §3.2).
  /// `null` bij een vrij gesprek. Reist mee naar de AI als **context** (beperkt de antwoorden) en wordt
  /// in de gebruikersapp getoond zodat de gebruiker het antwoord samenstelt. Bewust géén vrije
  /// gebruikersinvoer: alleen de begeleider (account-auth) kan dit zetten.
  caregiverQuestion   String?
  /// Het CAREGIVER-/ADMIN-account dat de vraag stelde (T7.1); `null` bij een vrij gesprek. Voor
  /// herkomst/diagnose — de eigenaar van de communicatie blijft de gebruiker (DESIGN §2, §3.3).
  startedByAccountId  String?
  startedAt DateTime @default(now())
  /// Het nog **onbeantwoorde** vraagaanbod van deze sessie (T10.3, DESIGN §7.5): de getoonde vraag en
  /// de aangeboden concepten in de getoonde volgorde, plus de fase/zekerheid van die beslissing.
  /// Vorm: `{ stepCount, question, concepts[], confidence, phase, done }`, bij het lezen met zod
  /// gevalideerd (`pendingOfferSchema`). `stepCount` maakt het aanbod zelf-invaliderend: hoort het niet
  /// bij het huidige aantal stappen, dan wordt er een nieuwe beslissing genomen.
  ///
  /// Waarom opslaan en niet herleiden: sinds de kandidaten uit **retrieval** komen (T10.2) en niet meer
  /// uit één boomknoop, is de beslissing geen pure functie meer van de stappen — een tweede AI-aanroep
  /// zou andere opties kunnen kiezen. Zonder vastlegging zou `↩ Terug` dus niet exact herstellen en zou
  /// een geldige keuze als `INVALID_CHOICE` geweigerd kunnen worden. `null` = geen openstaand aanbod.
  pendingOffer Json?
  /// Heeft de gebruiker zelf aangegeven dat de route **goed genoeg** is (T10.11, DESIGN §3.1)? Dan gaat
  /// het gesprek naar het voorstelscherm met de route zoals hij is, ook al zou de beslissingslaag nog
  /// willen verfijnen (§7.4). Nodig sinds T10.10: dat stelt pas voor als er niets meer te verfijnen valt,
  /// waardoor "Ik wil eten." — in AAC een volwaardige boodschap — anders onbereikbaar zou zijn.
  ///
  /// Wordt gewist zodra de gebruiker verder kiest, terug gaat of corrigeert: dan is de route veranderd en
  /// geldt zijn "genoeg" niet meer.
  readyToPropose Boolean @default(false)
  /// Bij hoeveel stappen er al een **verfijnronde** is gedaan na ❌ Nee (T10.12, DESIGN §3.4). `null` =
  /// nog niet op dit punt.
  ///
  /// ❌ betekent twee dingen die niet te onderscheiden zijn: "je zit in de goede richting maar niet
  /// specifiek genoeg" en "dit klopt helemaal niet". De eerste is de goedkoopste verklaring, dus die
  /// proberen we eerst: dezelfde route, maar de AI mag verfijningen aandragen ("brood" → boter, kaas,
  /// chocopasta) — ook als de bibliotheek die nog niet kent (§7.6 trap 3). Wijst de gebruiker het
  /// dáárna opnieuw af, dan klopte de laatste keuze zelf niet en rolt die terug.
  ///
  /// Vergelijken met het huidige aantal stappen maakt dit zelf-invaliderend: kiest de gebruiker een
  /// verfijning, dan hoort een volgende ❌ weer bij een nieuw punt en begint de cyclus opnieuw.
  refinedAtStep Int?
  /// De lopende **hypothese** van de AI over wat de gebruiker bedoelt (T10.8, DESIGN §7.1 taak 3, §7.4):
  /// `{ concepts[], confidence, reason, history[] }`, bij het lezen met zod gevalideerd
  /// (`hypothesisSchema`). Bewust **vluchtig**: bij het afronden van het gesprek (`/confirm`) wordt dit
  /// leeggemaakt — een onzekere aanname is geen bewaarde communicatie (DESIGN §3.6). Bevat uitsluitend
  /// AAC-concepten en getallen, nooit persoonlijke context (DESIGN §9.4).
  hypothesis Json?
  /// De **gespreksstrategie** van dit gesprek (T11.5, DESIGN §7.10): de sleutel van een ingebouwde
  /// aanpak, of `null` = volg de instelling van de gebruiker. Een begeleider kan hem meegeven bij het
  /// stellen van een vraag (§3.2): een vraag over pijn vraagt om een andere benadering dan "wat wil je
  /// doen vanmiddag". De resolutieorde is **gesprek → gebruiker → standaard** (`resolveStrategy`).
  ///
  /// De strategie ligt vast voor de duur van het gesprek: halverwege wisselen zou het vastgelegde
  /// aanbod (`pendingOffer`) en de lopende hypothese inconsistent maken. Op de API-grens tegen de
  /// registry gevalideerd; een opgeslagen sleutel die de registry niet meer kent valt bij het lezen
  /// terug op de gebruikersinstelling.
  strategy   String?

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps    ConversationStep[]
  /// De bij bevestiging opgeslagen boodschap(pen) van deze sessie (T4.3). In de MVP hoogstens één:
  /// een sessie wordt bij `confirm` afgerond (COMPLETED). Afgewezen voorstellen worden NOOIT opgeslagen.
  messages GeneratedMessage[]
  /// Correcties van de gebruiker (❌ op een voorstel, T5.4): correctie-signaal, geen leerdata.
  corrections CorrectionEvent[]

  @@index([userId])
}

/// Een door de (in deze fase gescripte) engine voorgestelde en door de gebruiker **bevestigde**
/// boodschap (T4.3, DESIGN §3.1, §3.6, §6.2 GeneratedMessage, FR-007). Kernprincipe (DESIGN §3.6):
/// alleen **bevestigde** communicatie wordt bewaard — een rij bestaat pas na `POST /conversation/{id}/
/// confirm`. Onzekere aannames en **afgewezen** voorstellen worden nooit opgeslagen; het genereren
/// (`/generate`) is dus bewust vluchtig en raakt de db niet. `confirmed` is daarmee in de MVP altijd
/// `true`, maar blijft expliciet in het model conform DESIGN §6.2 (en als anker voor latere statussen).
model GeneratedMessage {
  id        String   @id @default(cuid())
  sessionId String
  /// De geformuleerde zin uit de gekozen concepten (sjabloon-gebaseerd in deze fase; de
  /// AI-orchestrator neemt dit later over achter dezelfde interface — T5.3).
  message   String
  /// Of de gebruiker de boodschap bevestigde. In de MVP altijd `true` (alleen bevestigde
  /// boodschappen worden opgeslagen); expliciet gemodelleerd conform DESIGN §6.2.
  confirmed Boolean  @default(true)
  createdAt DateTime @default(now())

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Eén keuze in een gesprek (T4.1, DESIGN §3.1, §6.2). Elke stap legt vast wélke vraag getoond werd
/// (`question`) en welk AAC-concept de gebruiker koos (`selectedConcept` + `selectedSymbolId`). `order`
/// bepaalt de volgorde en maakt de terug-functie exact: de laatste stap verwijderen herstelt de vorige
/// context. `confidence` is voorbereidend op de AI-fase (§7.4) en blijft `null` in de gescripte engine
/// (er is nog geen AI-zekerheid). De samengestelde unieke sleutel `(sessionId, order)` voorkomt gaten/
/// duplicaten in de volgorde.
model ConversationStep {
  id               String   @id @default(cuid())
  sessionId        String
  /// Positie in het gesprek (0-based); de terug-functie verwijdert de hoogste.
  order            Int
  /// De vraag (prompttekst) die bij deze stap getoond werd.
  question         String
  /// Het gekozen AAC-concept (canonieke sleutel, bv. "walking").
  selectedConcept  String
  /// Het gekozen `AacSymbol`-id; `null` als het symbool later verwijderd is (geen harde FK i.v.m.
  /// de gedeelde, muteerbare bibliotheek). Zo blijft de historie leesbaar via `selectedConcept`.
  selectedSymbolId String?
  /// De interpretatie-zekerheid waarmee de vraag van déze stap werd **aangeboden** (§7.4); `null` als er
  /// geen AI-zekerheid bekend was. Bewust de zekerheid op het aanbiedmoment en niet die van de toestand
  /// erna: de stap legt vast wat de gebruiker te zien kreeg. De correctie-analyse gebruikt dit als
  /// terugval; haar primaire signaal is het kantelpunt van de hypothese (T10.8).
  confidence       Float?
  /// De concepten die bij déze vraag zijn **aangeboden**, in de getoonde volgorde (T10.3, DESIGN §7.5).
  /// Twee doelen: (1) `↩ Terug` herstelt de vorige vraag met exact dezelfde opties in plaats van met een
  /// nieuwe AI-beslissing, en (2) "Geen van deze past" sluit precies uit wat de gebruiker gezien heeft.
  /// Vorm: `string[]` (conceptsleutels), bij het lezen met zod gevalideerd. Lege lijst voor stappen van
  /// vóór T10.3.
  offeredConcepts  Json     @default("[]")
  createdAt        DateTime @default(now())

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, order])
  @@index([sessionId])
}

/// Een correctie van de gebruiker: bij ❌ ("Nee, dit klopt niet") op een voorstel heranalyseert de
/// orchestrator de route en bepaalt waar de vermoedelijk verkeerde afslag zat (T5.4, DESIGN §3.4,
/// §6.2 CorrectionEvent, §7.6, FR-009). De flow gaat NIET terug naar het begin: de vermoedelijke
/// foutstap (en alles erna) wordt teruggerold en er volgt een gerichtere hervraag, waarbij het
/// afgewezen concept in de rest van de sessie niet meer wordt aangeboden (nooit dezelfde foutieve
/// route, §7.5). Deze events worden bewaard als correctie-signaal, maar er wordt **niet** van geleerd
/// (§3.4 punt 4): ze raken nooit de `Preference`-laag (T6.3). Bewust géén communicatie-inhoud hier —
/// alleen welk concept op welke stap werd afgewezen (DESIGN §3.6, privacy by design).
model CorrectionEvent {
  id        String   @id @default(cuid())
  sessionId String
  /// Soort correctie: "wrong_guess" (de enige in de MVP; DESIGN §6.2). Gevalideerd op de grens; geen
  /// native enum i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header.
  type      String   @default("wrong_guess")
  /// De `order`-index van de teruggerolde stap die als vermoedelijke foutstap is aangemerkt.
  stepOrder Int
  /// Het AAC-concept dat op die stap gekozen was en nu is afgewezen; blijft de rest van de sessie
  /// uitgesloten van de aangeboden opties (§7.5).
  rejectedConcept String
  createdAt DateTime @default(now())

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Een door de AI voorgesteld nieuw begrip dat (nog) niet in de AAC-bibliotheek bestaat (DESIGN §6.2,
/// §7.6, FR-016, T5.2/T7.3). De **validatielaag** (T5.2) maakt zo'n voorstel aan wanneer de AI tijdens
/// communicatie een concept aandraagt dat noch als concept, noch als synoniem in de bibliotheek bestaat:
/// de optie wordt weggelaten (bereikt de gebruiker NOOIT — DESIGN §7.6) en het begrip belandt hier ter
/// beoordeling door een beheerder. Pas na goedkeuring (koppeling aan een `AacSymbol`, T7.3) mag de AI het
/// gebruiken. `concept` is uniek zodat herhaalde voorstellen van hetzelfde begrip één openstaand item
/// vormen (idempotente upsert), i.p.v. de reviewlijst te overspoelen.
model ConceptProposal {
  id             String   @id @default(cuid())
  /// De canonieke conceptsleutel die de AI voorstelde (lowercase-genormaliseerd), uniek.
  concept        String   @unique
  /// Korte onderbouwing waarom dit begrip nodig zou zijn (uit de `reason` van de AI-beslissing).
  reason         String
  /// Status: "PENDING" | "APPROVED" | "REJECTED" (gevalideerd op de grens; geen native enum i.v.m.
  /// SQLite/PostgreSQL-portabiliteit — zie schema-header). Nieuw voorstel start PENDING; T7.3 beoordeelt.
  status         String   @default("PENDING")
  /// Na goedkeuring: het `AacSymbol` waaraan het begrip gekoppeld is (T7.3). `null` zolang niet gekoppeld.
  /// Bewust geen harde FK (net als `ConversationStep.selectedSymbolId`) i.v.m. de muteerbare bibliotheek.
  linkedSymbolId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

/// Een geleerde **voorkeur** van een gebruiker (T6.3, DESIGN §3.8, §6.2 Preference, §7.1 taak 5, FR-014).
/// Het leermechanisme werkt strikt volgens de domeinregels (DESIGN §3.6, CLAUDE.md):
///
/// - **Alleen uit bevestigde communicatie.** Een voorkeur wordt uitsluitend bijgewerkt wanneer een
///   gebruiker een boodschap **bevestigt** (`POST /conversation/{id}/confirm`). Nooit uit afgewezen
///   voorstellen, correcties (§3.4 punt 4) of onzekere AI-aannames — die raken deze laag nooit.
/// - **Uitschakelbaar.** Bijwerken gebeurt alléén als `UserCommunicationProfile.aiLearningEnabled=true`;
///   staat de schakelaar uit, dan muteert er niets (en komen bestaande voorkeuren ook niet in de prompt).
/// - **Geen communicatie-inhoud.** Alleen de canonieke AAC-conceptsleutel + een afgeleide zekerheid en
///   teller worden bewaard — geen zinnen, geen vrije tekst (privacy by design, §9.4).
///
/// `confidence` (0–1) groeit met elke bevestigde keuze (afgeleid van `count`); `count` telt hoe vaak het
/// concept bevestigd is en voedt de **begeleider-suggestie** (§3.8): bij een vaak gekozen concept krijgt de
/// begeleider een voorstel om het als persoonlijke context toe te voegen. `suggestionStatus` onthoudt de
/// afhandeling van die suggestie ("none" → nog geen suggestie · "pending" → suggestie staat open ·
/// "accepted" → begeleider nam het over als context · "dismissed" → begeleider weigerde), zodat een
/// geweigerde suggestie niet blijft terugkomen. `source` legt de herkomst vast ("confirmed_usage", de enige
/// in de MVP). De unieke `(userId, concept)`-sleutel houdt één rij per concept per gebruiker.
model Preference {
  id              String   @id @default(cuid())
  userId          String
  /// De canonieke AAC-conceptsleutel (bv. "walking"); verwijst naar de bibliotheek, geen weergavetekst.
  concept         String
  /// Afgeleide zekerheid (0–1), groeit met het aantal bevestigingen (§7.4-schaal).
  confidence      Float    @default(0)
  /// Aantal keer dat dit concept in een bevestigde boodschap zat (voedt de suggestie-drempel, §3.8).
  count           Int      @default(0)
  /// Herkomst van de voorkeur: "confirmed_usage" (de enige in de MVP; DESIGN §6.2). Op de grens gevalideerd.
  source          String   @default("confirmed_usage")
  /// Status van de begeleider-suggestie: "none" | "pending" | "accepted" | "dismissed" (§3.8). Op de grens
  /// gevalideerd; geen native enum i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header.
  suggestionStatus String  @default("none")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, concept])
  @@index([userId])
}

/// Een audit-logregel over een **gevoelige actie** (T8.2, DESIGN §9.4). Append-only spoor van
/// wie-wat-wanneer op beveiligings-/beheerrelevante handelingen: login (geslaagd én mislukt),
/// instellingen, persoonlijke context, profielexport/-import en beheeracties (gebruikers,
/// begeleider-koppelingen, worker-tokens, conceptvoorstellen). Privacy by design (DESIGN §3.6, §9.4):
///
/// - **Nooit communicatie-inhoud.** Er worden géén zinnen, pictogramkeuzes, persoonlijke-context-PII of
///   andere vrije tekst gelogd — alleen een stabiele `action`-sleutel, de uitkomst en objectverwijzingen
///   (`targetType`/`targetId`). `metadataJson` bevat hoogstens kleine, niet-gevoelige context (bv. een
///   mislukkingsreden of het aantal gekoppelde begeleiders), nooit PII.
/// - **Bewust géén harde FK's** naar `Account`/`Organization`: het log is een onafhankelijk,
///   onveranderlijk spoor dat een verwijderde actor/tenant moet overleven (anders zou `onDelete: Cascade`
///   juist het bewijs van een verwijdering wissen). Verwijzingen zijn losse id's; de lijst-API filtert
///   op `organizationId` zodat een ADMIN alleen het spoor van de **eigen** organisatie ziet (tenant-isolatie).
model AuditLog {
  id             String   @id @default(cuid())
  /// Stabiele, machine-leesbare actiesleutel, bv. "auth.login", "user.settings.update",
  /// "profile.export" (zie audit/actions.ts). Bewust een string, geen native enum (SQLite/PostgreSQL).
  action         String
  /// Uitkomst: "success" | "failure". Mislukte logins zijn óók auditwaardig (brute-force-detectie).
  outcome        String   @default("success")
  /// Het handelende account (nullable: bij een mislukte login is er nog geen geverifieerd account).
  accountId      String?
  /// De tenant waarin de actie plaatsvond (nullable bij pre-auth acties zoals een mislukte login).
  organizationId String?
  /// Type van het doelobject, bv. "user" | "account" | "personalContext" | "workerToken" (nullable).
  targetType     String?
  /// Id van het doelobject (nullable).
  targetId       String?
  /// Client-IP (best-effort, achter de geconfigureerde proxy-hops), voor herkomst/diagnose.
  ip             String?
  /// Kleine, niet-gevoelige extra context als JSON-string. NOOIT communicatie-inhoud of vrije-tekst-PII.
  metadataJson   String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([accountId])
  @@index([action])
}

/// Een actieve login-sessie. Het sessietoken staat NOOIT plaintext in de db: we bewaren
/// alleen een SHA-256-hash (`tokenHash`). De client krijgt het rauwe token als
/// httpOnly+Secure cookie; bij elke request hashen we de cookie en zoeken hierop
/// (DESIGN §9.4, CLAUDE.md security-checklist). Verlopen sessies (`expiresAt`) zijn
/// ongeldig en worden opgeruimd.
model Session {
  id        String   @id @default(cuid())
  /// SHA-256-hash (hex) van het sessietoken. Uniek zodat lookup op hash direct raakt.
  tokenHash String   @unique
  accountId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Een infrastructuur-credential voor een externe AI-worker (T5.5, DESIGN §7.2, §9.2, §9.4, ADR-0010).
/// Losstaand van gebruiker-/device-/sessietokens: een worker is infrastructuur, geen gebruiker en geen
/// tenant. Het rauwe token staat NOOIT plaintext in de db — alleen de SHA-256-hash (`tokenHash`), net als
/// bij sessie- en apparaat-tokens. De worker stuurt het rauwe token als `Authorization: Bearer …` mee
/// (geen cookie: workers zijn geen browsers). Intrekbaar via `revokedAt`; optioneel verlopend via
/// `expiresAt`. `scopes` begrenst wat het token mag (nu alleen "ai:process"); komma-gescheiden, op de
/// grens gevalideerd (geen native enum i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header).
model WorkerToken {
  id         String    @id @default(cuid())
  /// Menselijke labelnaam (bv. "gpu-node-1"), puur voor beheer/diagnose.
  name       String
  /// SHA-256-hash (hex) van het worker-token. Uniek zodat lookup op hash direct raakt.
  tokenHash  String    @unique
  /// Toegestane scopes, komma-gescheiden (bv. "ai:process"). Op de grens gevalideerd.
  scopes     String    @default("ai:process")
  /// Ingetrokken op dit moment; daarna weigert `workerAuthorize` het token. `null` = actief.
  revokedAt  DateTime?
  /// Optionele vervaltijd; na dit moment is het token ongeldig. `null` = verloopt niet.
  expiresAt  DateTime?
  /// Laatst geziene activiteit (best-effort bijgewerkt bij claim/heartbeat), voor beheer/diagnose.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  jobs AiJob[]

  @@index([revokedAt])
}

/// Eén AI-aanvraag in de gedistribueerde wachtrij (T5.5, DESIGN §7.2, §7.7, §9.2, ADR-0010). De DB is de
/// bron van waarheid zodat een herstart of worker-crash geen aanvraag verliest. `payloadJson` bevat de
/// door `buildAiPrompt`/`buildMessagePrompt` samengestelde **beperkte** context (systeemregels + doel +
/// AAC-regels + gebruikers-/gesprekscontext); `resultJson` de door de worker ingeleverde, opnieuw met de
/// zod-schema's (T5.1) gevalideerde uitvoer. De uitvoer doorloopt daarna nog de AAC-validatielaag (T5.2)
/// — een worker wordt nooit vertrouwd. Bewust géén communicatie-inhoud buiten de AAC-concepten (privacy
/// by design, DESIGN §3.6, §9.4).
model AiJob {
  id             String    @id @default(cuid())
  /// De AI-taak: "select_next_question" | "generate_message" (op de grens gevalideerd; geen native enum
  /// i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header).
  task           String
  /// Status: "WAITING_FOR_WORKER" (over capaciteit, nog niet claimbaar) | "QUEUED" (claimbaar) |
  /// "CLAIMED" (in behandeling) | "SUCCEEDED" | "FAILED" | "EXPIRED". Op de grens gevalideerd.
  status         String    @default("QUEUED")
  /// De beperkte prompt-context als JSON-string (zie modeltoelichting).
  payloadJson    String
  /// Het door de worker ingeleverde resultaat als JSON-string; `null` tot succes.
  resultJson     String?
  /// Korte foutmelding bij een mislukte/teruggelegde job (geen interne stacktraces).
  errorMessage   String?
  /// Aantal keren dat de job geclaimd is; na `AI_WORKER_MAX_ATTEMPTS` teruglegging → FAILED.
  attempts       Int       @default(0)
  /// Het worker-token dat de job momenteel/als laatste claimde; `null` zolang niet geclaimd.
  claimedById    String?
  claimedAt      DateTime?
  /// Deadline van de huidige claim-lease; verstrijkt die zonder heartbeat/resultaat → teruggelegd.
  leaseExpiresAt DateTime?
  /// Uiterste moment waarop de job nog opgepakt mag worden; daarna → EXPIRED (nette wachtrij-timeout).
  expiresAt      DateTime
  /// De **gespreksstrategie** die deze aanvraag voortbracht (T11.6, DESIGN §7.10): puur de sleutel, als
  /// administratie voor het beheerscherm AI-activiteit — met meerdere aanpakken is "waarom deed de AI
  /// dit?" niet te beantwoorden zonder te weten wélke draaide. Bewust géén promptinhoud en geen
  /// persoonlijke context (DESIGN §9.4); `null` bij een boodschap-job of een oudere rij.
  strategy       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  claimedBy WorkerToken? @relation(fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([claimedById])
}
