// Prisma-schema voor Intento (DESIGN §6, §9.3).
//
// Bron van waarheid voor het relationele datamodel. DB-wijzigingen lopen ALTIJD via
// migraties (`npm run db:migrate`), nooit ad-hoc — zie CLAUDE.md kernprincipe 9.
//
// Portabiliteit: dev draait op SQLite, productie op PostgreSQL. Het schema blijft
// bewust PostgreSQL-compatibel: geen SQLite-only constructies en geen native enums
// (SQLite kent die niet) — categorie-/type-velden zijn `String` met de toegestane
// waarden in commentaar en worden op de grens met zod gevalideerd. Zie ADR-0003 en
// docs/data-model.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  // Dev/test: SQLite. Prod: zet dit op "postgresql" (ADR-0003). De verbinding zelf
  // staat niet meer in het schema (Prisma 7) maar in prisma.config.ts (CLI) en de
  // driver adapter in src/db/prisma.ts (runtime).
  provider = "sqlite"
}

/// Een Intento-omgeving (zorginstelling, familie of persoonlijk). Tenant-root: vrijwel
/// alle latere entiteiten hangen hieronder en elke query wordt op `organizationId`
/// gefilterd (multi-tenant-isolatie, DESIGN §9.4). Het eerste fundament-model in T0.2;
/// accounts, gebruikers en de rest volgen in latere taken.
model Organization {
  id        String   @id @default(cuid())
  /// Weergavenaam van de omgeving.
  name      String
  /// Soort omgeving: "family" | "care" | "personal" (gevalideerd op de API-grens).
  type      String
  createdAt DateTime @default(now())

  accounts Account[]
  users    User[]
}

/// De communicerende persoon (DESIGN §2, §6.2). Staat bewust los van `Account`: een
/// gebruiker hoeft geen eigen login te hebben (bediening kan via een gekoppelde tablet of
/// een begeleider), en één persoon is niet per se één login. `active` maakt het mogelijk een
/// gebruiker te deactiveren zonder gegevens te verwijderen. Tenant-gebonden via
/// `organizationId`: elke query wordt hierop gefilterd (multi-tenant-isolatie, DESIGN §9.4).
model User {
  id             String   @id @default(cuid())
  /// Weergavenaam van de persoon.
  name           String
  organizationId String
  /// Of de gebruiker actief is; inactief = behouden maar niet in gebruik.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 1-op-1 communicatie-instellingen; verdwijnt mee als de gebruiker wordt verwijderd.
  communicationProfile UserCommunicationProfile?
  /// Gekoppelde begeleiders (CAREGIVER-accounts) die deze gebruiker mogen helpen.
  caregiverLinks       CaregiverAssignment[]
  /// Gekoppelde apparaten (tablets) die als deze gebruiker in de gebruikersapp starten.
  devices              Device[]
  /// Openstaande/gebruikte koppelcodes waarmee een apparaat aan deze gebruiker koppelt.
  deviceLinkCodes      DeviceLinkCode[]
  /// Gespreksessies van deze gebruiker (T4.1); verdwijnen mee als de gebruiker wordt verwijderd.
  conversationSessions ConversationSession[]

  @@index([organizationId])
}

/// Communicatie-instellingen per gebruiker (DESIGN §5.3, §6.2). 1-op-1 aan `User`
/// (`userId` is de primaire sleutel). De waarden sturen de gebruikersapp aan:
/// - `iconsPerScreen`: aantal opties per scherm — alleen 2/4/6/8 (standaard 4), afgedwongen
///   met zod op de API-grens (geen native enum i.v.m. SQLite/PostgreSQL-portabiliteit).
/// - `showText`: tekst onder pictogrammen tonen (ondersteunend, standaard aan).
/// - `aiLearningEnabled`: leren van bevestigde communicatie toestaan (uitschakelbaar).
/// - `supportMode`: ondersteuningsmodus (begeleider tikt aan namens de gebruiker).
model UserCommunicationProfile {
  userId            String  @id
  iconsPerScreen    Int     @default(4)
  showText          Boolean @default(true)
  aiLearningEnabled Boolean @default(true)
  supportMode       Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Een login voor een persoon met toegang tot een organisatie (DESIGN §2, §6.2). De rol
/// bepaalt wat het account mag (ADMIN/CAREGIVER/USER). Wachtwoorden worden nooit
/// plaintext opgeslagen — alleen een argon2id-hash. `email` is platformbreed uniek zodat
/// login op e-mail alleen het account eenduidig bepaalt (MVP-keuze, zie ADR-0004).
model Account {
  id             String   @id @default(cuid())
  /// Login-identiteit; platformbreed uniek (lowercase genormaliseerd op de API-grens).
  email          String   @unique
  /// Weergavenaam van de accounthouder (bv. de admin die zich zelf aanmeldde, T1.3).
  /// Nullable: geseede/bestaande accounts hebben geen naam en login vereist er geen.
  name           String?
  /// argon2id-hash van het wachtwoord. Nooit het wachtwoord zelf.
  passwordHash   String
  /// Rol: "ADMIN" | "CAREGIVER" | "USER" (gevalideerd op de API-grens; geen native enum
  /// i.v.m. PostgreSQL/SQLite-portabiliteit, zie schema-header en ADR-0003).
  role           String
  organizationId String
  /// Account-lockout tegen brute force: telt opeenvolgende mislukte logins; `lockedUntil`
  /// blokkeert login tot dat moment. Beide worden bij een geslaagde login gereset.
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  /// E-mailverificatie (T1.4, DESIGN §2, §9.4). `null` = nog niet geverifieerd; anders het moment
  /// waarop het e-mailadres via een verificatietoken is bevestigd. Onbevestigde accounts mogen
  /// inloggen maar bepaalde gevoelige acties (bv. gebruikers aanmaken) zijn geblokkeerd tot
  /// verificatie — zie docs/security.md. Geseede/bestaande accounts (vóór T1.4) blijven `null`.
  emailVerifiedAt DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]
  /// Gebruikers waaraan dit account (als CAREGIVER) gekoppeld is.
  caregiverLinks CaregiverAssignment[]
  /// Openstaande/gebruikte e-mailverificatietokens van dit account.
  emailVerificationTokens EmailVerificationToken[]

  @@index([organizationId])
}

/// Een e-mailverificatietoken (T1.4, DESIGN §2, §9.4). Wordt bij zelfaanmelding (T1.3) en bij
/// `resend` aangemaakt en per e-mail als **rauwe** token naar de accounthouder gestuurd. Net als
/// sessie- en apparaat-tokens staat het token NOOIT plaintext in de db — alleen de SHA-256-hash
/// (`tokenHash`). Bij inwisselen (`/auth/verify-email`) hashen we het aangeboden token en zoeken
/// hierop. Tokens zijn **eenmalig** (`usedAt` gezet zodra ingewisseld) en **verlopen** (`expiresAt`);
/// een verlopen of gebruikt token wordt geweigerd. `onDelete: Cascade` ruimt tokens op als het
/// account verdwijnt.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  /// SHA-256-hash (hex) van het verificatietoken. Uniek zodat inwisselen direct op de hash zoekt.
  tokenHash String    @unique
  accountId String
  /// Moment van inwisselen; `null` zolang ongebruikt. Eenmalig gebruik wordt hierop bewaakt.
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Koppeling tussen een begeleider (CAREGIVER-`Account`) en een `User` (T2.2, DESIGN §2,
/// FR-017). Een begeleider ziet en beheert **alleen** de gebruikers waaraan hij expliciet
/// gekoppeld is; zonder koppeling geeft toegang tot die gebruiker 403. De koppeling is een
/// many-to-many tussen account en gebruiker; de tenant-grens (zelfde organisatie) wordt op
/// de API-grens bewaakt. De samengestelde sleutel voorkomt dubbele koppelingen, en beide
/// kanten `onDelete: Cascade` ruimen de koppeling op als het account of de gebruiker verdwijnt.
model CaregiverAssignment {
  userId    String
  accountId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
}

/// Een gekoppelde tablet (DESIGN §6.2, FR-018, T2.3). Een apparaat is aan **precies één**
/// `User` gebonden en start daarna direct in de gebruikersapp zonder dagelijkse login. Net als
/// bij sessies staat het apparaat-token NOOIT plaintext in de db — alleen de SHA-256-hash
/// (`tokenHash`). De client krijgt het rauwe token als langlevende httpOnly+Secure cookie; bij
/// elke request hashen we de cookie en zoeken hierop. Het token geeft alléén toegang tot de
/// eigen-gebruiker-endpoints (device-scope), nooit tot beheer- of accountroutes. `lastActive`
/// legt het laatste gebruik vast (monitoring, DESIGN §9.4 — geen communicatie-inhoud).
model Device {
  id         String   @id @default(cuid())
  userId     String
  /// Soort apparaat, bv. "tablet" (gevalideerd op de API-grens; geen native enum i.v.m.
  /// SQLite/PostgreSQL-portabiliteit, zie schema-header).
  type       String   @default("tablet")
  /// SHA-256-hash (hex) van het langlevende apparaat-token. Uniek zodat lookup direct raakt.
  tokenHash  String   @unique
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Een koppelcode die een beheerder genereert om een tablet aan een gebruiker te koppelen
/// (DESIGN §3.7 stap 5, FR-018, T2.3). De code wisselt op `POST /devices/link` in voor een
/// apparaat-token. Beveiliging: de code staat **gehasht** at-rest (`codeHash`, SHA-256) — net
/// als tokens lekt de db geen bruikbare codes. Codes zijn **eenmalig** (`usedAt` gezet zodra
/// ingewisseld) en **verlopen** (`expiresAt`); een verlopen of gebruikte code wordt geweigerd.
model DeviceLinkCode {
  id        String    @id @default(cuid())
  /// SHA-256-hash (hex) van de koppelcode. Uniek zodat inwisselen direct op de hash zoekt.
  codeHash  String    @unique
  userId    String
  /// Moment van inwisselen; `null` zolang ongebruikt. Eenmalig gebruik wordt hierop bewaakt.
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Een pictogram uit de beheerde AAC-bibliotheek (DESIGN §6.2, FR-015, T3.1). De bibliotheek
/// begrenst de AI: tijdens communicatie mag alleen uit deze symbolen worden gekozen (DESIGN §7.6).
/// Ze zijn **platformbreed gedeeld**, niet tenant-gebonden — één beheerde woordenschat voor alle
/// omgevingen (persoonlijke context/voorkeuren blijven wél per gebruiker en tenant).
///
/// Velden:
/// - `concept`: canonieke, unieke conceptsleutel (lowercase, bv. "walking"). Hiernaar verwijzen
///   relaties en straks de AI-context (§6.3); niet de weergavetekst.
/// - `label`: weergavetekst voor de gebruiker (Nederlands, bv. "Wandelen").
/// - `category`: categoriesleutel ("intent" | "activity" | ... ; gevalideerd op de API-grens,
///   geen native enum i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header).
/// - `glyph`: de visuele weergave als emoji-fallback. Zolang er geen afbeelding is geüpload rendert
///   de server hieruit een SVG-placeholder (`GET /aac/images/:id`). Beheerders beheren dit in T3.2.
/// - `imageData` / `imageMimeType`: een door een beheerder geüpload pictogram (T3.2). Bewust **in de
///   db** opgeslagen (Bytes) i.p.v. op het bestandssysteem: portabel op SQLite én PostgreSQL, één
///   backup-/migratiepad en geen pad-/serving-beveiliging op schijf. Beide `null` = nog geen upload,
///   dan valt serving terug op de glyph-placeholder. Alleen een mime-allowlist (raster) wordt
///   geaccepteerd, met groottelimiet (zie env `AAC_IMAGE_MAX_BYTES`).
/// - `imageVersion`: teller die bij elke upload omhooggaat en als cache-buster (`?v=`) in de
///   afbeeldings-URL komt, zodat een vervangen pictogram niet uit de browsercache blijft komen.
/// - `synonyms`: alternatieve zoektermen (JSON-array van strings) — gestructureerd bewaard zodat de
///   beheer-UI ze los kan beheren en de zoek-API ze kan teruggeven.
/// - `searchText`: afgeleide, genormaliseerde (lowercase) zoekindex = concept + label + synoniemen.
///   De zoek-API matcht hierop met één `contains`, wat **portabel én hoofdletterongevoelig** is op
///   zowel SQLite als PostgreSQL (beide kanten vooraf lowercase → geen DB-specifieke `mode` nodig).
///   Wordt herbouwd bij elke wijziging van het symbool of zijn synoniemen.
model AacSymbol {
  id            String   @id @default(cuid())
  concept       String   @unique
  label         String
  category      String
  glyph         String
  /// Geüploade afbeeldingsbytes (T3.2); `null` = terugvallen op de glyph-placeholder.
  imageData     Bytes?
  /// Mime-type van de geüploade afbeelding (uit de mime-allowlist); `null` als er geen upload is.
  imageMimeType String?
  /// Cache-buster: telt uploads, komt als `?v=` in de afbeeldings-URL.
  imageVersion  Int      @default(0)
  /// Bronvermelding/licentie van een gekoppelde externe afbeelding (OpenSymbols, T3.3). Alle `null`
  /// bij een zelf-geüploade afbeelding of de glyph-placeholder. Reist mee met het pictogram zodat de
  /// licentie-attributie altijd zichtbaar is (CC-attributie: auteur + bron + licentie).
  imageLicense    String?
  imageLicenseUrl String?
  imageAuthor     String?
  imageAuthorUrl  String?
  imageSourceUrl  String?
  /// JSON-array van synoniemen (zoektermen). Op de grens met zod gevalideerd/geparseerd.
  synonyms      Json
  /// Genormaliseerde zoekindex (lowercase); afgeleid, nooit rechtstreeks aan de client getoond.
  searchText    String
  createdAt     DateTime @default(now())

  /// Relaties waarin dit symbool de ouder is (bv. "buiten" bevat "wandelen").
  parentLinks AacConceptRelation[] @relation("parent")
  /// Relaties waarin dit symbool het kind is.
  childLinks  AacConceptRelation[] @relation("child")

  @@index([category])
}

/// Een begripsrelatie tussen twee AAC-symbolen (DESIGN §6.2, FR-015, T3.1). Vormt de boom waarlangs
/// de (later AI-gestuurde) verfijning loopt: van intentie naar steeds concreter concept
/// (bv. "buiten" → "wandelen"). `relation` typeert de relatie ("contains" in de MVP; ruimte voor
/// meer types later). De samengestelde unieke sleutel voorkomt dubbele relaties; beide kanten
/// `onDelete: Cascade` ruimen de relatie op als een van de symbolen verdwijnt.
model AacConceptRelation {
  id       String @id @default(cuid())
  parentId String
  childId  String
  /// Type relatie: "contains" | … (gevalideerd op de API-grens; geen native enum i.v.m.
  /// SQLite/PostgreSQL-portabiliteit — zie schema-header).
  relation String @default("contains")

  parent AacSymbol @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  child  AacSymbol @relation("child", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, relation])
  @@index([parentId])
  @@index([childId])
}

/// Een gespreksessie: het tijdelijke communicatieproces waarin een gebruiker via pictogramkeuzes
/// zijn intentie opbouwt (T4.1, DESIGN §3.1, §6.2). De sessie is aan **precies één** `User` gebonden
/// (gebruiker-isolatie, DESIGN §9.4): een tablet mag alleen de sessies van zijn eigen gebruiker zien.
/// In deze fase draait de vraagselectie op een **gescripte engine** over de AAC-relatieboom; de
/// AI-orchestrator neemt die rol later over achter dezelfde interface. Alleen bevestigde communicatie
/// wordt uiteindelijk bewaard (DESIGN §3.6) — het genereren/bevestigen volgt in T4.3.
model ConversationSession {
  id        String   @id @default(cuid())
  userId    String
  /// Status: "ACTIVE" | "COMPLETED" | "ABANDONED" (gevalideerd op de API-grens; geen native enum
  /// i.v.m. SQLite/PostgreSQL-portabiliteit — zie schema-header). In T4.1 alleen ACTIVE; T4.3 rondt af.
  status    String   @default("ACTIVE")
  startedAt DateTime @default(now())

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps ConversationStep[]

  @@index([userId])
}

/// Eén keuze in een gesprek (T4.1, DESIGN §3.1, §6.2). Elke stap legt vast wélke vraag getoond werd
/// (`question`) en welk AAC-concept de gebruiker koos (`selectedConcept` + `selectedSymbolId`). `order`
/// bepaalt de volgorde en maakt de terug-functie exact: de laatste stap verwijderen herstelt de vorige
/// context. `confidence` is voorbereidend op de AI-fase (§7.4) en blijft `null` in de gescripte engine
/// (er is nog geen AI-zekerheid). De samengestelde unieke sleutel `(sessionId, order)` voorkomt gaten/
/// duplicaten in de volgorde.
model ConversationStep {
  id               String   @id @default(cuid())
  sessionId        String
  /// Positie in het gesprek (0-based); de terug-functie verwijdert de hoogste.
  order            Int
  /// De vraag (prompttekst) die bij deze stap getoond werd.
  question         String
  /// Het gekozen AAC-concept (canonieke sleutel, bv. "walking").
  selectedConcept  String
  /// Het gekozen `AacSymbol`-id; `null` als het symbool later verwijderd is (geen harde FK i.v.m.
  /// de gedeelde, muteerbare bibliotheek). Zo blijft de historie leesbaar via `selectedConcept`.
  selectedSymbolId String?
  /// Voorbereidend op de AI-fase; `null` in de gescripte engine (nog geen AI-zekerheid).
  confidence       Float?
  createdAt        DateTime @default(now())

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, order])
  @@index([sessionId])
}

/// Een actieve login-sessie. Het sessietoken staat NOOIT plaintext in de db: we bewaren
/// alleen een SHA-256-hash (`tokenHash`). De client krijgt het rauwe token als
/// httpOnly+Secure cookie; bij elke request hashen we de cookie en zoeken hierop
/// (DESIGN §9.4, CLAUDE.md security-checklist). Verlopen sessies (`expiresAt`) zijn
/// ongeldig en worden opgeruimd.
model Session {
  id        String   @id @default(cuid())
  /// SHA-256-hash (hex) van het sessietoken. Uniek zodat lookup op hash direct raakt.
  tokenHash String   @unique
  accountId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
