// Prisma-schema voor Intento (DESIGN §6, §9.3).
//
// Bron van waarheid voor het relationele datamodel. DB-wijzigingen lopen ALTIJD via
// migraties (`npm run db:migrate`), nooit ad-hoc — zie CLAUDE.md kernprincipe 9.
//
// Portabiliteit: dev draait op SQLite, productie op PostgreSQL. Het schema blijft
// bewust PostgreSQL-compatibel: geen SQLite-only constructies en geen native enums
// (SQLite kent die niet) — categorie-/type-velden zijn `String` met de toegestane
// waarden in commentaar en worden op de grens met zod gevalideerd. Zie ADR-0003 en
// docs/data-model.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  // Dev/test: SQLite. Prod: zet dit op "postgresql" (ADR-0003). De verbinding zelf
  // staat niet meer in het schema (Prisma 7) maar in prisma.config.ts (CLI) en de
  // driver adapter in src/db/prisma.ts (runtime).
  provider = "sqlite"
}

/// Een Intento-omgeving (zorginstelling, familie of persoonlijk). Tenant-root: vrijwel
/// alle latere entiteiten hangen hieronder en elke query wordt op `organizationId`
/// gefilterd (multi-tenant-isolatie, DESIGN §9.4). Het eerste fundament-model in T0.2;
/// accounts, gebruikers en de rest volgen in latere taken.
model Organization {
  id         String   @id @default(cuid())
  /// Weergavenaam van de omgeving.
  name       String
  /// Soort omgeving: "family" | "care" | "personal" (gevalideerd op de API-grens).
  type       String
  /// Platformorganisatie: alleen ADMINs van zo'n org mogen wat het hele platform raakt beheren
  /// (bv. de platformitems van de Vocabulary). Standaard `false`; de bootstrap-seed zet dit op
  /// `true`, en zelfaanmelding alleen bij de allereerste aanmelding op een lege database mét
  /// `BOOTSTRAP_FIRST_ADMIN_AS_OPERATOR` aan.
  isPlatform Boolean  @default(false)
  /// Of de omgeving actief is (T8.3). Een platform-operator kan een organisatie **deactiveren** om
  /// misbruik te stoppen: dat is bewust geen verwijdering (gegevens blijven staan, herstel is één
  /// klik) maar wel een harde stop — inloggen, bestaande accountsessies én gekoppelde tablets van
  /// een inactieve organisatie worden geweigerd (`ORGANIZATION_SUSPENDED`). Zie docs/security.md.
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  /// Bewaartermijn in dagen (INTENTO-NEW-DESIGN §53), 7–365. `null` = de standaard uit
  /// `RETENTION_DEFAULT_DAYS` (90). Het opruimen zelf gebeurt in N14.2.
  retentionDays Int?

  accounts              Account[]
  users                 User[]
  communicationSessions CommunicationSession[]
  vocabularyItems       VocabularyItem[]
  vocabularyGaps        VocabularyGap[]
  contacts              Contact[]
}

/// De communicerende persoon (DESIGN §2, §6.2). Staat bewust los van `Account`: een
/// gebruiker hoeft geen eigen login te hebben (bediening kan via een gekoppelde tablet of
/// een begeleider), en één persoon is niet per se één login. `active` maakt het mogelijk een
/// gebruiker te deactiveren zonder gegevens te verwijderen. Tenant-gebonden via
/// `organizationId`: elke query wordt hierop gefilterd (multi-tenant-isolatie, DESIGN §9.4).
model User {
  id             String   @id @default(cuid())
  /// Weergavenaam van de persoon.
  name           String
  organizationId String
  /// Of de gebruiker actief is; inactief = behouden maar niet in gebruik.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 1-op-1 communicatie-instellingen; verdwijnt mee als de gebruiker wordt verwijderd.
  communicationProfile  UserCommunicationProfile?
  communicationSessions CommunicationSession[]
  /// Gekoppelde begeleiders (CAREGIVER-accounts) die deze gebruiker mogen helpen.
  caregiverLinks        CaregiverAssignment[]
  /// Gekoppelde apparaten (tablets) die als deze gebruiker in de gebruikersapp starten.
  devices               Device[]
  /// Openstaande/gebruikte koppelcodes waarmee een apparaat aan deze gebruiker koppelt.
  deviceLinkCodes       DeviceLinkCode[]
  /// De mensen naar wie deze gebruiker een bevestigde boodschap kan sturen (N10.1).
  contacts              Contact[]

  @@index([organizationId])
}

/// Een contact van een gebruiker (INTENTO-NEW-DESIGN §28, §39): naar wie hij een bevestigde boodschap
/// kan sturen ("Mama", "broer"). Beheerd door de beheerder of een gekoppelde begeleider.
///
/// - `nameEncrypted`, `emailEncrypted`: persoonsgegevens, versleuteld (AES-256-GCM). Ze gaan nooit naar
///   een LLM; de agentdienst krijgt alleen een id en een pictogram (V6).
/// - `relation`: de soort relatie (bv. "moeder"), geen naam; vrij te kiezen, kort.
/// - `vocabularyItemId`: het pictogram uit de Vocabulary van de organisatie.
/// - `emailVerifiedAt`: opt-in (V5, N10.2); `null` = nog niet bevestigd, dan wordt het contact niet
///   aangeboden. Een gewijzigd e-mailadres zet de bevestiging terug.
/// - `active`: uit = tijdelijk niet aanbieden, zonder te verwijderen. `sortOrder`: de vaste volgorde
///   zonder Experience (§29).
/// - `organizationId` staat er dubbel (ook via de gebruiker) zodat elke query direct op de tenant filtert.
model Contact {
  id               String    @id @default(cuid())
  userId           String
  organizationId   String
  nameEncrypted    String
  relation         String?
  vocabularyItemId String?
  emailEncrypted   String
  emailVerifiedAt  DateTime?
  active           Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vocabularyItem VocabularyItem? @relation(fields: [vocabularyItemId], references: [id], onDelete: SetNull)

  @@index([userId, sortOrder])
  @@index([organizationId])
}

/// Communicatie-instellingen per gebruiker (INTENTO-NEW-DESIGN §50). 1-op-1 aan `User`
/// (`userId` is de primaire sleutel). Waarden als `String`/`Int`; de toegestane waarden bewaakt zod
/// op de API-grens (geen native enums i.v.m. SQLite/PostgreSQL-portabiliteit).
/// - `interactionMode`: `binary` (standaard), `multi` of `ai` (§11).
/// - `optionsPerScreen`: 2–8 opties in multi-icon (standaard 4).
/// - `questionStrategy`: vraagstrategie (§7.1), standaard `general_to_specific`.
/// - `experienceEnabled`: leren van deze gebruiker (§22), standaard aan.
/// - `maxQuestions`: maximum aantal vragen per gesprek (S1), 5–30, standaard 15.
/// - `showText`: tekst onder pictogrammen tonen (standaard aan).
/// - `speechEnabled`: spreekt de tablet uit wat er op het scherm staat? Standaard **uit**.
/// - `speechVoice`: met welke stem. Een sleutel uit de gedeelde stemcatalogus, op de API-grens met
///   zod gevalideerd; `device` betekent "de tablet spreekt zelf".
model UserCommunicationProfile {
  userId            String  @id
  interactionMode   String  @default("binary")
  optionsPerScreen  Int     @default(4)
  questionStrategy  String  @default("general_to_specific")
  experienceEnabled Boolean @default(true)
  maxQuestions      Int     @default(15)
  showText          Boolean @default(true)
  speechEnabled     Boolean @default(false)
  speechVoice       String  @default("nl_NL-pim-medium")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Een login voor een persoon met toegang tot een organisatie (DESIGN §2, §6.2). De rol
/// bepaalt wat het account mag (ADMIN/CAREGIVER/USER). Wachtwoorden worden nooit
/// plaintext opgeslagen — alleen een argon2id-hash. `email` is platformbreed uniek zodat
/// login op e-mail alleen het account eenduidig bepaalt (MVP-keuze, zie ADR-0004).
model Account {
  id                  String    @id @default(cuid())
  /// Login-identiteit; platformbreed uniek (lowercase genormaliseerd op de API-grens).
  email               String    @unique
  /// Weergavenaam van de accounthouder (bv. de admin die zich zelf aanmeldde, T1.3).
  /// Nullable: geseede/bestaande accounts hebben geen naam en login vereist er geen.
  name                String?
  /// argon2id-hash van het wachtwoord. Nooit het wachtwoord zelf.
  passwordHash        String
  /// Rol: "ADMIN" | "CAREGIVER" | "USER" (gevalideerd op de API-grens; geen native enum
  /// i.v.m. PostgreSQL/SQLite-portabiliteit, zie schema-header en ADR-0003).
  role                String
  organizationId      String
  /// Account-lockout tegen brute force: telt opeenvolgende mislukte logins; `lockedUntil`
  /// blokkeert login tot dat moment. Beide worden bij een geslaagde login gereset.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// E-mailverificatie (T1.4, DESIGN §2, §9.4). `null` = nog niet geverifieerd; anders het moment
  /// waarop het e-mailadres via een verificatietoken is bevestigd. Onbevestigde accounts mogen
  /// inloggen maar bepaalde gevoelige acties (bv. gebruikers aanmaken) zijn geblokkeerd tot
  /// verificatie — zie docs/security.md. Geseede/bestaande accounts (vóór T1.4) blijven `null`.
  emailVerifiedAt     DateTime?
  /// Tijdelijk-wachtwoord-markering (T2.6, DESIGN §2, §9.4). `true` zolang dit account nog draait op
  /// het **server-gegenereerde** wachtwoord dat een beheerder bij het aanmaken (T2.4) te zien kreeg:
  /// dat wachtwoord is dus bij een tweede persoon bekend en het account is tot die tijd niet echt van
  /// de houder alleen. Gezet bij `createCaregiverAccount`, gewist zodra de houder zelf via
  /// `POST /auth/password` (T2.5) een eigen wachtwoord kiest. Zolang de vlag staat laat `authorize()`
  /// alléén het eigen account bekijken en het wachtwoord wijzigen toe (`403 PASSWORD_CHANGE_REQUIRED`
  /// op al het overige) — zie docs/security.md. Standaard `false`: zelf gekozen wachtwoorden
  /// (zelfaanmelding T1.3, seed) zijn nooit bij een ander bekend.
  mustChangePassword  Boolean   @default(false)
  /// Platform-operator (T8.3, DESIGN §9.1, §9.4). `true` = dit account mag de operatorconsole
  /// gebruiken: organisaties en accounts **over tenants heen** inzien en beheren. Bewust een aparte
  /// vlag naast `role`, niet een vierde rol: de rol bepaalt wat je binnen je eigen organisatie mag
  /// (en blijft overal tenant-gefilterd), terwijl deze vlag een tweede, expliciet gescheiden
  /// bevoegdheid ontgrendelt op een eigen `/operator`-routetak met een eigen guard. De vlag telt
  /// alléén binnen een organisatie met `isPlatform=true` (dubbele voorwaarde) en wordt op twee
  /// plekken gezet, allebei bootstrap: de seed, en — als `BOOTSTRAP_FIRST_ADMIN_AS_OPERATOR` aan
  /// staat — de allereerste zelfaanmelding op een lege database. Er is geen API waarmee een
  /// bestaand account de vlag uitdeelt of krijgt. Zie ADR-0011 en docs/security.md.
  isOperator          Boolean   @default(false)
  /// Meldingen (N9.3, INTENTO-NEW-DESIGN §17): een beheerder die dit aanzet, krijgt één e-mail per
  /// **nieuw** ontbrekend woord van zijn organisatie (niet per keer dat het voorkomt). Standaard uit:
  /// de teller in het menu is de gewone melding; e-mail is "als de beheerder dat wil".
  notifyGapsByEmail   Boolean   @default(false)
  createdAt           DateTime  @default(now())

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions                Session[]
  /// Gebruikers waaraan dit account (als CAREGIVER) gekoppeld is.
  caregiverLinks          CaregiverAssignment[]
  /// Openstaande/gebruikte e-mailverificatietokens van dit account.
  emailVerificationTokens EmailVerificationToken[]
  vocabularyItems         VocabularyItem[]

  @@index([organizationId])
}

/// Een e-mailverificatietoken (T1.4, DESIGN §2, §9.4). Wordt bij zelfaanmelding (T1.3) en bij
/// `resend` aangemaakt en per e-mail als **rauwe** token naar de accounthouder gestuurd. Net als
/// sessie- en apparaat-tokens staat het token NOOIT plaintext in de db — alleen de SHA-256-hash
/// (`tokenHash`). Bij inwisselen (`/auth/verify-email`) hashen we het aangeboden token en zoeken
/// hierop. Tokens zijn **eenmalig** (`usedAt` gezet zodra ingewisseld) en **verlopen** (`expiresAt`);
/// een verlopen of gebruikt token wordt geweigerd. `onDelete: Cascade` ruimt tokens op als het
/// account verdwijnt.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  /// SHA-256-hash (hex) van het verificatietoken. Uniek zodat inwisselen direct op de hash zoekt.
  tokenHash String    @unique
  accountId String
  /// Moment van inwisselen; `null` zolang ongebruikt. Eenmalig gebruik wordt hierop bewaakt.
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Koppeling tussen een begeleider (CAREGIVER-`Account`) en een `User` (T2.2, DESIGN §2,
/// FR-017). Een begeleider ziet en beheert **alleen** de gebruikers waaraan hij expliciet
/// gekoppeld is; zonder koppeling geeft toegang tot die gebruiker 403. De koppeling is een
/// many-to-many tussen account en gebruiker; de tenant-grens (zelfde organisatie) wordt op
/// de API-grens bewaakt. De samengestelde sleutel voorkomt dubbele koppelingen, en beide
/// kanten `onDelete: Cascade` ruimen de koppeling op als het account of de gebruiker verdwijnt.
model CaregiverAssignment {
  userId    String
  accountId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
}

/// Een gekoppelde tablet (DESIGN §6.2, FR-018, T2.3). Een apparaat is aan **precies één**
/// `User` gebonden en start daarna direct in de gebruikersapp zonder dagelijkse login. Net als
/// bij sessies staat het apparaat-token NOOIT plaintext in de db — alleen de SHA-256-hash
/// (`tokenHash`). De client krijgt het rauwe token als langlevende httpOnly+Secure cookie; bij
/// elke request hashen we de cookie en zoeken hierop. Het token geeft alléén toegang tot de
/// eigen-gebruiker-endpoints (device-scope), nooit tot beheer- of accountroutes. `lastActive`
/// legt het laatste gebruik vast (monitoring, DESIGN §9.4 — geen communicatie-inhoud).
model Device {
  id         String   @id @default(cuid())
  userId     String
  /// Soort apparaat, bv. "tablet" (gevalideerd op de API-grens; geen native enum i.v.m.
  /// SQLite/PostgreSQL-portabiliteit, zie schema-header).
  type       String   @default("tablet")
  /// SHA-256-hash (hex) van het langlevende apparaat-token. Uniek zodat lookup direct raakt.
  tokenHash  String   @unique
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Een koppelcode die een beheerder genereert om een tablet aan een gebruiker te koppelen
/// (DESIGN §3.7 stap 5, FR-018, T2.3). De code wisselt op `POST /devices/link` in voor een
/// apparaat-token. Beveiliging: de code staat **gehasht** at-rest (`codeHash`, SHA-256) — net
/// als tokens lekt de db geen bruikbare codes. Codes zijn **eenmalig** (`usedAt` gezet zodra
/// ingewisseld) en **verlopen** (`expiresAt`); een verlopen of gebruikte code wordt geweigerd.
model DeviceLinkCode {
  id        String    @id @default(cuid())
  /// SHA-256-hash (hex) van de koppelcode. Uniek zodat inwisselen direct op de hash zoekt.
  codeHash  String    @unique
  userId    String
  /// Moment van inwisselen; `null` zolang ongebruikt. Eenmalig gebruik wordt hierop bewaakt.
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Een audit-logregel over een **gevoelige actie** (T8.2, DESIGN §9.4). Append-only spoor van
/// wie-wat-wanneer op beveiligings-/beheerrelevante handelingen: login (geslaagd én mislukt),
/// instellingen, profielexport/-import en beheeracties (gebruikers, begeleider-koppelingen).
/// Privacy by design:
///
/// - **Nooit communicatie-inhoud.** Er worden géén zinnen, pictogramkeuzes, persoonlijke-context-PII of
///   andere vrije tekst gelogd — alleen een stabiele `action`-sleutel, de uitkomst en objectverwijzingen
///   (`targetType`/`targetId`). `metadataJson` bevat hoogstens kleine, niet-gevoelige context (bv. een
///   mislukkingsreden of het aantal gekoppelde begeleiders), nooit PII.
/// - **Bewust géén harde FK's** naar `Account`/`Organization`: het log is een onafhankelijk,
///   onveranderlijk spoor dat een verwijderde actor/tenant moet overleven (anders zou `onDelete: Cascade`
///   juist het bewijs van een verwijdering wissen). Verwijzingen zijn losse id's; de lijst-API filtert
///   op `organizationId` zodat een ADMIN alleen het spoor van de **eigen** organisatie ziet (tenant-isolatie).
model AuditLog {
  id             String   @id @default(cuid())
  /// Stabiele, machine-leesbare actiesleutel, bv. "auth.login", "user.settings.update",
  /// "profile.export" (zie audit/actions.ts). Bewust een string, geen native enum (SQLite/PostgreSQL).
  action         String
  /// Uitkomst: "success" | "failure". Mislukte logins zijn óók auditwaardig (brute-force-detectie).
  outcome        String   @default("success")
  /// Het handelende account (nullable: bij een mislukte login is er nog geen geverifieerd account).
  accountId      String?
  /// De tenant waarin de actie plaatsvond (nullable bij pre-auth acties zoals een mislukte login).
  organizationId String?
  /// Type van het doelobject, bv. "user" | "account" (nullable).
  targetType     String?
  /// Id van het doelobject (nullable).
  targetId       String?
  /// Client-IP (best-effort, achter de geconfigureerde proxy-hops), voor herkomst/diagnose.
  ip             String?
  /// Kleine, niet-gevoelige extra context als JSON-string. NOOIT communicatie-inhoud of vrije-tekst-PII.
  metadataJson   String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([accountId])
  @@index([action])
}

/// Een actieve login-sessie. Het sessietoken staat NOOIT plaintext in de db: we bewaren
/// alleen een SHA-256-hash (`tokenHash`). De client krijgt het rauwe token als
/// httpOnly+Secure cookie; bij elke request hashen we de cookie en zoeken hierop
/// (DESIGN §9.4, CLAUDE.md security-checklist). Verlopen sessies (`expiresAt`) zijn
/// ongeldig en worden opgeruimd.
model Session {
  id        String   @id @default(cuid())
  /// SHA-256-hash (hex) van het sessietoken. Uniek zodat lookup op hash direct raakt.
  tokenHash String   @unique
  accountId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Eén symbool in de **eigen Vocabulary** van Intento (INTENTO-NEW-DESIGN §15, §39). Geen persoonlijke
/// inhoud. Tijdens een gesprek gebruikt Intento alleen `approved` items die voor de organisatie
/// beschikbaar zijn: de platformitems (`organizationId` null, de startset) plus die van de eigen
/// organisatie — nooit die van een andere.
///
/// - `labels`, `concepts`, `contexts` zijn JSON-arrays van strings (op de grens met zod gevalideerd).
///   Het eerste label is het hoofdlabel; de rest zijn synoniemen.
/// - `searchText`: vooraf in kleine letters samengevoegde labels + concepten, zodat zoeken op SQLite en
///   PostgreSQL hetzelfde werkt zonder databasespecifieke opties.
/// - `status`: `approved` (bruikbaar) of `retired` (ingetrokken: niet meer aangeboden, wel bewaard zolang
///   de provenance ernaar verwijst). Een item wordt nooit verwijderd.
/// - `labelStatus`: `reviewed` (door een mens) of `machine` (machinevertaling, nog na te kijken).
/// - `source`: `seed` (startset), `external` (import) of `own` (eigen afbeelding + woord).
/// - Licentie en herkomst per item; `(sourceName, sourceRef)` is uniek, zodat een import nooit dubbelt.
/// - De afbeelding staat in de bestandsopslag (`assetPath`, relatief aan `STORAGE_DIR`), met het
///   gecontroleerde `mimeType`, `sha256` en `bytes`.
model VocabularyItem {
  id             String    @id @default(cuid())
  organizationId String?
  labels         Json
  concepts       Json
  contexts       Json
  searchText     String
  partOfSpeech   String?
  isStart        Boolean   @default(false)
  sortOrder      Int       @default(0)
  status         String    @default("approved")
  labelStatus    String    @default("reviewed")
  source         String
  licenseKey     String
  licenseUrl     String?
  author         String?
  authorUrl      String?
  sourceName     String?
  sourceUrl      String?
  sourceRef      String?
  importedAt     DateTime?
  assetPath      String?
  mimeType       String?
  sha256         String?
  bytes          Int?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Account?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  gaps         VocabularyGap[]
  contacts     Contact[]

  @@unique([sourceName, sourceRef])
  @@index([organizationId, status])
  @@index([status, labelStatus])
}

/// Een ontbrekend woord (Vocabulary gap, INTENTO-NEW-DESIGN §17, §39): een betekenis waarvoor de eigen
/// Vocabulary geen goed pictogram heeft. De backend voegt de gaps uit elke beurt samen **per concept per
/// organisatie**; er staat bewust **geen** gebruiker of gesprek aan (geen persoonlijke inhoud).
///
/// - `conceptKey`: het taalneutrale concept (bv. `dizziness`); uniek per organisatie.
/// - `label`, `context`, `bestAvailableItemId`, `lastConfidence`: van de laatste keer dat hij voorkwam.
/// - `occurrences`: in hoeveel beurten hij voorkwam; `firstSeenAt`/`lastSeenAt`.
/// - `status`: `open`, `resolved` (de beheerder heeft een woord toegevoegd) of `dismissed` (genegeerd).
///   Komt een opgelost woord toch weer voor, dan gaat het terug naar `open`; een genegeerd woord blijft
///   genegeerd (de teller loopt wel door).
model VocabularyGap {
  id                  String   @id @default(cuid())
  organizationId      String
  conceptKey          String
  label               String
  context             String?
  bestAvailableItemId String?
  lastConfidence      Float
  occurrences         Int      @default(1)
  firstSeenAt         DateTime
  lastSeenAt          DateTime
  status              String   @default("open")

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bestAvailableItem VocabularyItem? @relation(fields: [bestAvailableItemId], references: [id], onDelete: SetNull)

  @@unique([organizationId, conceptKey])
  @@index([organizationId, status, lastSeenAt])
}

/// Eén gesprek op de tablet (INTENTO-NEW-DESIGN §5, §39). Heet bewust niet `Session`: die naam is van
/// de inlogsessies. `status`: `active`, `confirmed` (de gebruiker zei JA op "Bedoel je …?") of `stopped`.
/// Een gesprek loopt zolang `endedAt` leeg is — ook na de bevestiging (daarna kan nog gedeeld worden);
/// een bevestigd gesprek dat eindigt blijft `confirmed`. `currentTurn` wijst naar de beurt die nu op het
/// scherm staat.
model CommunicationSession {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  status         String    @default("active")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  currentTurn    Int       @default(0)

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  turns              SessionTurn[]
  presentationEvents PresentationEvent[]
  observedEvents     ObservedEvent[]
  inferences         Inference[]
  agentDecisions     AgentDecision[]
  intent             CommunicationIntent?

  @@index([userId, status])
  @@index([organizationId, startedAt])
}

/// De momentopname van één beurt: de Session State en wat er op het scherm stond, **versleuteld**
/// (AES-256-GCM, `ENCRYPTION_KEY`). Beurten zijn append-only met een oplopend nummer; `previousTurn` is
/// de beurt waar deze op volgde in het gesprek, zodat ↩ Terug exact de vorige momentopname terugzet
/// (als nieuwe beurt) zonder de agents opnieuw aan te roepen.
model SessionTurn {
  id                    String   @id @default(cuid())
  sessionId             String
  turn                  Int
  previousTurn          Int?
  stateEncrypted        String
  presentationEncrypted String
  createdAt             DateTime @default(now())

  session CommunicationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, turn])
}

// --- Provenance (INTENTO-NEW-DESIGN §2.5, §26, §27, §41) ---------------------------------------------
// Presented, Observed en Inferred staan elk in een eigen tabel en worden nooit samengevoegd. Presented
// en Observed legt de backend vast; Inferred en de agentbeslissingen komen van de agentdienst. Alles
// verdwijnt met het gesprek (cascade), dus binnen de bewaartermijn (§53).

/// **Presented**: wat er op het scherm stond, op het moment dat het naar de tablet ging. `optionsJson`
/// bevat per optie verwijzing, soort, item/contact, concept, representatie en plek — geen labels, want
/// een label kan een contactnaam zijn. Tekst en labels staan versleuteld in `contentEncrypted`.
model PresentationEvent {
  id               String   @id @default(cuid())
  sessionId        String
  turn             Int
  kind             String
  mode             String
  optionsJson      Json
  contentEncrypted String
  createdAt        DateTime @default(now())

  session CommunicationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, turn])
}

/// **Observed**: wat de gebruiker deed. `type`: `start`, `answer_yes`, `answer_no`, `select_option`,
/// `none_of_these`, `back`, `stop`. `optionRef` en `position` (plek van de gekozen optie, door de backend
/// uit de presentatie afgeleid) bij een keuze; `responseTimeMs` gemeten op de tablet.
model ObservedEvent {
  id             String   @id @default(cuid())
  sessionId      String
  turn           Int
  type           String
  optionRef      String?
  position       Int?
  responseTimeMs Int?
  createdAt      DateTime @default(now())

  session CommunicationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, turn])
}

/// **Inferred**: wat een agent concludeert. Nooit een feit (§36). De payload is versleuteld.
model Inference {
  id               String   @id @default(cuid())
  sessionId        String
  turn             Int
  agent            String
  kind             String
  payloadEncrypted String
  confidence       Float?
  createdAt        DateTime @default(now())

  session CommunicationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, turn])
}

/// Eén agentaanroep (§27): agent, status (`success`/`fallback`/`failed`, of `invalid` als de backend
/// het antwoord verwierp), model, promptversie, duur en validatie. Geen prompttekst, geen inhoud.
model AgentDecision {
  id            String   @id @default(cuid())
  sessionId     String
  turn          Int
  agent         String
  status        String
  model         String?
  promptVersion String?
  latencyMs     Int
  validation    String?
  reason        String?
  createdAt     DateTime @default(now())

  session CommunicationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, turn])
}

/// De **bevestigde boodschap** (Communication Intent, §31): pas de boodschap van de gebruiker na zijn
/// JA op "Bedoel je: …?". Alleen de backend maakt hem aan, alleen na een Observed JA op een
/// `confirm_message`-presentatie met precies die tekst (I2); wat de agent zelf "bevestigd" noemt telt
/// niet. Eén per gesprek. Het bericht staat versleuteld; de concepten (taalneutrale sleutels) niet.
/// `turn` is de beurt van het "Bedoel je"-scherm waarop JA werd gezegd.
model CommunicationIntent {
  id               String   @id @default(cuid())
  sessionId        String   @unique
  userId           String
  organizationId   String
  turn             Int
  messageEncrypted String
  concepts         Json
  confidence       Float?
  confirmedAt      DateTime @default(now())

  session CommunicationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, confirmedAt])
  @@index([userId, confirmedAt])
}
