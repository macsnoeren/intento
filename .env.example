# Voorbeeld-omgevingsvariabelen voor de Intento-server.
# Kopieer naar server/.env en vul in. NOOIT echte secrets committen.
# Houd dit bestand gelijk met server/src/env.ts.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (Prisma) ---
# Dev/test: SQLite-bestand, relatief aan de server-map (server/prisma/dev.db).
# Prod: PostgreSQL-connectiestring, bijv. postgresql://user:pass@host:5432/intento
# Zie docs/adr/0003 en docs/data-model.md. Wordt gebruikt door de CLI (prisma.config.ts)
# én de runtime driver adapter (server/src/db/prisma.ts).
DATABASE_URL=file:./prisma/dev.db

# --- Netwerk ---
# Herkomst die CORS mag aanspreken (de web-client tijdens ontwikkeling).
CORS_ORIGIN=http://localhost:5173
# `Secure`-vlag op cookies; moet true zijn in productie (HTTPS-prod-guard).
COOKIE_SECURE=false
# Welke proxy's vóór de app het client-IP (X-Forwarded-For) mogen bepalen. Wijs ze aan op
# ADRES; een aantal hops is geen geldige waarde meer (die vorm viel te misleiden en is uit
# fastify verwijderd). Kies:
#   false        geen proxy — het adres van de verbinding is het client-IP. Standaard.
#   uniquelocal  de privéranges. Dit wil je achter een reverse proxy in hetzelfde
#                container-/privénetwerk, met geen poort van buitenaf op de app.
#   loopback     alleen 127.0.0.1/::1.
#   true         alles vertrouwen — alleen als niets buiten de proxy de app kan bereiken.
#   of een IP, CIDR of komma-gescheiden lijst, bv. 172.18.0.0/16
TRUST_PROXY=false

# --- Auth / sessies (T1.1) ---
# Levensduur van een login-sessie in uren (default 168 = 7 dagen).
SESSION_TTL_HOURS=168
# Account-lockout: aantal opeenvolgende mislukte logins voor tijdelijke blokkade.
LOGIN_MAX_ATTEMPTS=5
# Duur van de lockout in minuten nadat de drempel is bereikt.
LOGIN_LOCKOUT_MINUTES=15
# Strenge rate limiting op /auth/login: max verzoeken per IP per venster.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=1
# Krijgt de ALLEREERSTE zelfaanmelding op een lege database de platform-operatorrol (de console die
# over organisaties heen kijkt)? Standaard uit, en dat is de veilige stand: zelfaanmelding is publiek,
# dus met deze vlag aan is die rol voor wie zich als eerste aanmeldt — op een verse, bereikbare
# omgeving hoeft dat jij niet te zijn. Bedoeld gebruik: aanzetten, jezelf aanmelden, klaar. Zodra er
# één account bestaat doet de vlag niets meer, dus hij ontwapent zichzelf.
BOOTSTRAP_FIRST_ADMIN_AS_OPERATOR=false

# Strenge rate limiting op /auth/register (zelfaanmelding, T1.3): max verzoeken per IP per venster.
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MINUTES=15
# Rate limiting op /auth/password (eigen wachtwoord wijzigen, T2.5). De route is al geauthenticeerd,
# maar elke poging kost een argon2-verificatie en raadt effectief het huidige wachtwoord. Bewust
# geen account-lockout hier: een gekaapte sessie zou de eigenaar daarmee kunnen buitensluiten.
PASSWORD_CHANGE_RATE_LIMIT_MAX=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_MINUTES=15
# Rate limiting op /admin/accounts/{id}/password (beheerder geeft een nieuw tijdelijk wachtwoord uit,
# T2.7). ADMIN-only en tenant-gebonden, dus niets te raden — maar elke aanroep logt een collega
# overal uit en zet een wachtwoord dat die collega nog niet kent. Ruimer dan login; het is een
# zeldzame, bewuste beheeractie.
PASSWORD_RESET_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# --- Tabletkoppeling (T2.3) ---
# Levensduur van een koppelcode in minuten (kort — direct op de tablet invoeren).
DEVICE_CODE_TTL_MINUTES=15
# Levensduur van het apparaat-token (cookie + db) in dagen (lang — geen dagelijkse login).
DEVICE_TOKEN_TTL_DAYS=365
# Strenge rate limiting op /devices/link: max verzoeken per IP per venster (codes raden).
DEVICE_LINK_RATE_LIMIT_MAX=10
DEVICE_LINK_RATE_LIMIT_WINDOW_MINUTES=1

# --- Bestandsopslag en afbeeldings-URL's (INTENTO-NEW-DESIGN §20, §51, §53) ---
# Map voor de afbeeldingen van de Vocabulary, buiten de webroot (relatief aan de server-map).
STORAGE_DIR=./storage
# Geheim waarmee afbeeldings-URL's ondertekend worden (HMAC). In productie verplicht een eigen waarde;
# de dev-default wordt dan geweigerd. Genereren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASSET_URL_SECRET=dev-only-change-me
# Hoe lang een ondertekende afbeeldings-URL geldig is, in seconden (60 tot 604800; standaard 3600).
ASSET_URL_TTL_SECONDS=3600

# --- Afbeeldingen die binnenkomen (INTENTO-NEW-DESIGN §53) ---
# Maximale grootte (bytes) van een eigen upload of een geïmporteerde afbeelding. Groter wordt
# geweigerd. Standaard 1 MB (1048576).
UPLOAD_MAX_BYTES=1048576

# --- OpenSymbols-integratie (zoeken in en importeren uit een externe bron) ---
# De backend praat namens de beheer-UI met OpenSymbols (de client praat nooit rechtstreeks).
# Basis-URL van de API (https).
OPENSYMBOLS_API_URL=https://www.opensymbols.org
# Gedeeld geheim om een kortlevend access-token op te halen (aanvragen via opensymbols.org).
# LEEG LATEN = integratie uitgeschakeld: de zoek-/koppelendpoints antwoorden dan met 503.
OPENSYMBOLS_SECRET=
# Time-out (ms) voor externe OpenSymbols-aanroepen (default 10000).
OPENSYMBOLS_TIMEOUT_MS=10000

# --- E-mailverificatie (T1.4) ---
# Afzenderadres van systeemmails (verificatiemail). RFC 5322-vorm mag ("Naam <adres>").
MAIL_FROM=Intento <no-reply@intento.local>
#
# De mailserver kan op twee manieren; kies er één. Zet je ze allebei, dan weigert de app te
# starten in plaats van er stilletjes één te kiezen.
#
# MANIER 1 — de losse velden, zoals een hostingpakket ze opgeeft. Geen codeerregels: een
# wachtwoord met @ / : # ? erin gaat letterlijk mee. Dit is de makkelijkste weg.
#
#   SMTP_HOST=mail.mijndomein.nl
#   SMTP_PORT=587
#   SMTP_SECURE=tls
#   SMTP_USER=noreply@jouwdomein.nl
#   SMTP_PASSWORD=het-wachtwoord-van-die-mailbox
#   SMTP_TIMEOUT_SECONDS=15
#
# SMTP_SECURE bepaalt hoe de verbinding beveiligd wordt, en de poort volgt eruit als je
# SMTP_PORT leeg laat:
#   tls   STARTTLS op 587 — het gangbaarst, en de standaard. Werkt dat niet, probeer ssl.
#   ssl   TLS vanaf de eerste byte, op 465.
#   none  géén TLS, op 25. Alleen toegestaan ZONDER SMTP_USER: met inloggegevens erbij zou het
#         het wachtwoord in platte tekst versturen, en daar weigert de app op te starten.
# SMTP_USER is meestal het volledige e-mailadres van een bestaande mailbox op het domein.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
# Seconden voordat een niet-reagerende mailserver wordt opgegeven (default 15).
SMTP_TIMEOUT_SECONDS=15
#
# MANIER 2 — alles in één verbindingsstring, bv. smtp://user:pass@smtp.host:587 (STARTTLS) of
# smtps://user:pass@smtp.host:465 (TLS vanaf de eerste byte).
# Schema en poort moeten bij elkaar passen: een STARTTLS-poort (587/25) hoort bij `smtp://`,
# een implicit-TLS-poort (465) bij `smtps://`. Verkeerd gecombineerd geeft de misleidende
# TLS-fout "wrong version number" bij het verbinden.
# Tekens als @ en : in gebruikersnaam of wachtwoord mogen gewoon, die worden correct geparsed —
# maar een / ? of # in het wachtwoord moet je percent-coderen. Heb je zo'n wachtwoord, neem dan
# manier 1.
SMTP_URL=
#
# TLS is bij beide manieren verplicht zodra er wordt ingelogd: het transport zet `requireTLS`,
# dus een mislukte STARTTLS-upgrade laat de verzending falen in plaats van in platte tekst door
# te gaan.
# ALLEBEI LEEG LATEN = log-transport: mails worden niet echt verstuurd maar gelogd (dev/test),
# zodat de app zonder mailserver draait. In productie moet er één van de twee staan (prod-guard).
# Basis-URL waarnaar de verificatielink in de mail wijst (server hangt er ?token=… achter).
# Wijst naar de web-app; buiten productie mag http, in productie moet dit https zijn.
EMAIL_VERIFICATION_URL_BASE=http://localhost:5173/verify-email
# Levensduur van een verificatietoken in uren (default 24).
EMAIL_VERIFICATION_TTL_HOURS=24

# Basis-URL van de web-app, voor links in mails (bv. een melding aan de beheerder).
# Bewust zonder pad. Moet https zijn in productie.
APP_BASE_URL=http://localhost:5173
# Strenge rate limiting op /auth/verify-email/resend: max verzoeken per IP per venster.
RESEND_RATE_LIMIT_MAX=3
RESEND_RATE_LIMIT_WINDOW_MINUTES=15

# --- Bewaartermijn (INTENTO-NEW-DESIGN §53) ---
# Standaard aantal dagen dat gesprekken en hun provenance bewaard blijven, voor organisaties die zelf
# geen termijn kozen (7–365, standaard 90). Een beheerder kan per organisatie afwijken.
RETENTION_DEFAULT_DAYS=90

# --- Agentdienst (INTENTO-NEW-DESIGN §3.1, ADR-0017) ---
# De backend roept de Python-agentdienst (agent-service/) rechtstreeks aan; de tablet nooit.
# LEEG LATEN = geen agentdienst: een gesprek starten geeft dan 503 AGENT_UNAVAILABLE.
# Lokaal: http://127.0.0.1:5003 (zie agent-service/README.md).
AGENT_SERVICE_URL=
# Gedeeld geheim, exact gelijk aan SERVICE_TOKEN in agent-service/.env. Verplicht zodra
# AGENT_SERVICE_URL gezet is. Genereren: python -c "import secrets; print('agt_' + secrets.token_hex(24))"
AGENT_SERVICE_TOKEN=
# Plain http naar de agentdienst in productie toestaan. Alleen voor een container op een gesloten
# netwerk zonder gepubliceerde poort (zoals in compose); anders false laten en https gebruiken.
AGENT_ALLOW_INSECURE_HTTP=false

# --- Spraakuitvoer (T18.1, DESIGN §5.3, §9.2, §9.4) ---
# De tablet laat uitspreken wat er op zijn scherm staat; de backend praat namens hem met de
# spraakdienst uit `speech-service/` (Piper, lokaal — de zin van de gebruiker gaat nooit naar een
# cloudleverancier). Zie docs/adr/0015-speech-synthesis-piper.md.
# `none` (standaard): geen spraakdienst; de spraakendpoints antwoorden met 503 SPEECH_UNAVAILABLE en
# de tablet valt terug op de stem van het apparaat zelf. `http`: de dienst hieronder.
SPEECH_PROVIDER=none
# Basis-URL van de spraakdienst. Verplicht bij SPEECH_PROVIDER=http; in productie https, tenzij
# SPEECH_ALLOW_INSECURE_HTTP hieronder aanstaat.
SPEECH_SERVICE_URL=
# Staat plain http naar de spraakdienst toe in productie. Uit laten zodra de dienst bereikbaar is
# over een netwerk dat niet van jou is. Het bestaat voor één opstelling: backend en spraakdienst als
# containers op hetzelfde gesloten netwerk, waar de dienst geen poort publiceert — daar is TLS tussen
# twee processen op dezelfde machine een certificaat om uit te geven en te roteren zonder dat er
# verkeer is dat iemand onderweg ziet. Zet je hem aan, dan is SPEECH_SERVICE_TOKEN VERPLICHT: zonder
# TLS is dat gedeelde geheim het enige dat de dienst nog afschermt.
SPEECH_ALLOW_INSECURE_HTTP=false
# Gedeeld geheim (Bearer) waarmee de backend zich bij die dienst meldt. Verzin het zelf
# (`python -c "import secrets; print('spr_' + secrets.token_hex(24))"`) en zet exact dezelfde waarde
# in speech-service/.env als SERVICE_TOKEN. Lopen ze uiteen → 401 en "beluisteren lukte niet".
# Leeg = geen controle aan beide kanten; alleen verdedigbaar als de dienst op localhost luistert.
SPEECH_SERVICE_TOKEN=
# Time-out (ms) voor één synthese-aanroep. Piper doet een zin in ± 100 ms; dit is de noodrem.
SPEECH_TIMEOUT_MS=10000
# Aantal fragmenten in de geheugencache (sleutel: hash van tekst + stem). Alleen in het geheugen:
# audio van wat de gebruiker zei wordt nooit opgeslagen. 0 = niet cachen.
SPEECH_CACHE_MAX_ENTRIES=500
# Rate limiting op de spraakendpoints (per IP).
SPEECH_RATE_LIMIT_MAX=120
SPEECH_RATE_LIMIT_WINDOW_MINUTES=1

# --- Seed (alleen voor `npm run db:seed`) ---
# Eerste ADMIN-account. Overschrijf het wachtwoord buiten lokale ontwikkeling.
SEED_ADMIN_EMAIL=admin@intento.local
SEED_ADMIN_PASSWORD=change-me-admin

# --- Secrets (prod-guard: server weigert te starten in productie met deze defaults) ---
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SIGNING_SECRET ondertekent sessie-cookies (vanaf T1.1).
SIGNING_SECRET=dev-only-change-me
# ENCRYPTION_KEY versleutelt gevoelige velden at-rest (vanaf T6.1).
ENCRYPTION_KEY=dev-only-change-me-32-bytes-hex

# --- Web-app (Vite, T2.1) ---
# Hoort in web/.env (of als shell-var bij de build). Basis-URL van de backend-API die de
# web-app aanspreekt. Standaard http://localhost:3000; zet dit op de publieke API-URL in prod.
# VITE_API_URL=http://localhost:3000
