# Voorbeeld-omgevingsvariabelen voor de Intento-server.
# Kopieer naar server/.env en vul in. NOOIT echte secrets committen.
# Houd dit bestand gelijk met server/src/env.ts.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (Prisma) ---
# Dev/test: SQLite-bestand, relatief aan de server-map (server/prisma/dev.db).
# Prod: PostgreSQL-connectiestring, bijv. postgresql://user:pass@host:5432/intento
# Zie docs/adr/0003 en docs/data-model.md. Wordt gebruikt door de CLI (prisma.config.ts)
# én de runtime driver adapter (server/src/db/prisma.ts).
DATABASE_URL=file:./prisma/dev.db

# --- Netwerk ---
# Herkomst die CORS mag aanspreken (de web-client tijdens ontwikkeling).
CORS_ORIGIN=http://localhost:5173
# `Secure`-vlag op cookies; moet true zijn in productie (HTTPS-prod-guard).
COOKIE_SECURE=false
# Aantal proxy-hops voor client-IP-bepaling achter een reverse proxy (0 = geen).
TRUST_PROXY=0

# --- Auth / sessies (T1.1) ---
# Levensduur van een login-sessie in uren (default 168 = 7 dagen).
SESSION_TTL_HOURS=168
# Account-lockout: aantal opeenvolgende mislukte logins voor tijdelijke blokkade.
LOGIN_MAX_ATTEMPTS=5
# Duur van de lockout in minuten nadat de drempel is bereikt.
LOGIN_LOCKOUT_MINUTES=15
# Strenge rate limiting op /auth/login: max verzoeken per IP per venster.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=1
# Strenge rate limiting op /auth/register (zelfaanmelding, T1.3): max verzoeken per IP per venster.
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MINUTES=15
# Rate limiting op /auth/password (eigen wachtwoord wijzigen, T2.5). De route is al geauthenticeerd,
# maar elke poging kost een argon2-verificatie en raadt effectief het huidige wachtwoord. Bewust
# geen account-lockout hier: een gekaapte sessie zou de eigenaar daarmee kunnen buitensluiten.
PASSWORD_CHANGE_RATE_LIMIT_MAX=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_MINUTES=15
# Rate limiting op /admin/accounts/{id}/password (beheerder geeft een nieuw tijdelijk wachtwoord uit,
# T2.7). ADMIN-only en tenant-gebonden, dus niets te raden — maar elke aanroep logt een collega
# overal uit en zet een wachtwoord dat die collega nog niet kent. Ruimer dan login; het is een
# zeldzame, bewuste beheeractie.
PASSWORD_RESET_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# --- Tabletkoppeling (T2.3) ---
# Levensduur van een koppelcode in minuten (kort — direct op de tablet invoeren).
DEVICE_CODE_TTL_MINUTES=15
# Levensduur van het apparaat-token (cookie + db) in dagen (lang — geen dagelijkse login).
DEVICE_TOKEN_TTL_DAYS=365
# Strenge rate limiting op /devices/link: max verzoeken per IP per venster (codes raden).
DEVICE_LINK_RATE_LIMIT_MAX=10
DEVICE_LINK_RATE_LIMIT_WINDOW_MINUTES=1

# --- AAC-bibliotheek (T3.2) ---
# Maximale grootte (bytes) van een geüpload AAC-pictogram. Groter wordt geweigerd (413).
# Standaard 512 KiB (524288). Alleen PNG/JPEG/WebP worden geaccepteerd (server-side allowlist).
# Geldt ook voor een via OpenSymbols opgehaalde afbeelding (T3.3).
AAC_IMAGE_MAX_BYTES=524288

# --- OpenSymbols-integratie (T3.3) ---
# De backend proxyt namens de beheer-UI naar OpenSymbols (de client praat nooit rechtstreeks).
# Basis-URL van de API (https).
OPENSYMBOLS_API_URL=https://www.opensymbols.org
# Gedeeld geheim om een kortlevend access-token op te halen (aanvragen via opensymbols.org).
# LEEG LATEN = integratie uitgeschakeld: de zoek-/koppelendpoints antwoorden dan met 503.
OPENSYMBOLS_SECRET=
# Time-out (ms) voor externe OpenSymbols-aanroepen (default 10000).
OPENSYMBOLS_TIMEOUT_MS=10000

# --- E-mailverificatie (T1.4) ---
# Afzenderadres van systeemmails (verificatiemail). RFC 5322-vorm mag ("Naam <adres>").
MAIL_FROM=Intento <no-reply@intento.local>
# SMTP-verbindingsstring, bv. smtp://user:pass@smtp.host:587 (STARTTLS) of
# smtps://user:pass@smtp.host:465 (TLS vanaf de eerste byte).
# Schema en poort moeten bij elkaar passen: een STARTTLS-poort (587/25) hoort bij `smtp://`,
# een implicit-TLS-poort (465) bij `smtps://`. Verkeerd gecombineerd geeft de misleidende
# TLS-fout "wrong version number" bij het verbinden.
# TLS is in beide gevallen verplicht: het transport zet `requireTLS`, dus een mislukte
# STARTTLS-upgrade laat de verzending falen in plaats van in platte tekst door te gaan.
# Tekens als @ en : in gebruikersnaam of wachtwoord mogen gewoon, die worden correct geparsed.
# LEEG LATEN = log-transport: mails worden niet echt verstuurd maar gelogd (dev/test), zodat de
# app zonder mailserver draait. In productie is een niet-lege SMTP_URL verplicht (prod-guard).
SMTP_URL=
# Basis-URL waarnaar de verificatielink in de mail wijst (server hangt er ?token=… achter).
# Wijst naar de web-app; buiten productie mag http, in productie moet dit https zijn.
EMAIL_VERIFICATION_URL_BASE=http://localhost:5173/verify-email
# Levensduur van een verificatietoken in uren (default 24).
EMAIL_VERIFICATION_TTL_HOURS=24

# Basis-URL van de web-app; gebruikt voor de link in een meldingsmail aan de begeleider (T13.2).
# Bewust zonder pad: de begeleider komt na inloggen zelf op zijn scherm terecht.
# Moet https zijn in productie.
APP_BASE_URL=http://localhost:5173
# Krijgt een gekoppelde begeleider een mail zodra "zijn" gebruiker een boodschap bevestigt (T13.2)?
# Standaard aan. De mail bevat de naam van de gebruiker en het tijdstip, nooit de boodschap zelf:
# e-mail is een extern kanaal en de zin is communicatie-inhoud (DESIGN §9.4).
# Zet op false als een organisatie niet per bericht gemaild wil worden.
NOTIFY_CAREGIVERS_BY_EMAIL=true
# Strenge rate limiting op /auth/verify-email/resend: max verzoeken per IP per venster.
RESEND_RATE_LIMIT_MAX=3
RESEND_RATE_LIMIT_WINDOW_MINUTES=15

# --- AI-orchestrator (T5.1) ---
# De backend praat namens de client met de LLM (de client nooit rechtstreeks). De provider zit achter
# een provider-agnostische interface (docs/adr/0008). Welke provider: mock | queue | ollama.
# `mock`  = deterministische provider voor dev/test (geen netwerk, geen key nodig).
# `queue` = gedistribueerde workers (docs/adr/0010): de backend zet jobs op een wachtrij, externe
#           workers (T5.6, bv. Ollama op een andere machine) verwerken ze. Geen AI_API_URL/AI_MODEL nodig.
#
# LET OP (T9.8): `mock` betekent dat er GEEN echte AI meedenkt — de mock kiest simpelweg de
# bibliotheekvolgorde. Dat is aan de gespreksflow niet te zien, dus in de gebruikerstest leek het of de
# AI niets deed. De server logt daarom bij het opstarten expliciet welke modus draait, en de UI toont een
# statuslampje (`GET /ai/status`, T9.4). Wil je echte AI: zet `AI_PROVIDER=queue` én start een AI-worker
# (zie ai-worker/README.md) — zonder draaiende worker blijft elk gesprek in de wachtstand hangen.
AI_PROVIDER=mock
# Verbindingsgegevens voor een DIRECTE provider (leeg bij mock/queue). Buiten test moet de URL https zijn.
# AI_API_KEY is een infrastructuur-credential en gaat NOOIT naar de client.
AI_API_URL=
AI_API_KEY=
# Model-identifier van een directe provider. Leeg bij mock/queue.
AI_MODEL=
# Time-out (ms) voor een AI-aanroep; bij queue ook de max wachttijd op een worker-resultaat (default 30000).
AI_REQUEST_TIMEOUT_MS=30000

# --- Gedistribueerde AI-workers (T5.5, docs/adr/0010) — alleen van kracht bij AI_PROVIDER=queue ---
# Maximum aantal gelijktijdig actieve jobs (QUEUED+CLAIMED). Daarboven → WAITING_FOR_WORKER (backpressure):
# de aanvrager krijgt een 503 AI_WORKER_BUSY met positie i.p.v. te blokkeren.
AI_WORKER_MAX_CONCURRENT_JOBS=4
# Lease-duur (ms) van een geclaimde job; verstrijkt die zonder heartbeat → job teruggelegd (crash-herstel).
AI_WORKER_LEASE_MS=30000
# Maximaal aantal claim-pogingen voordat een job wordt afgeschreven (FAILED).
AI_WORKER_MAX_ATTEMPTS=3
# Uiterste wachttijd (ms) dat een niet-opgepakte job in de wachtrij mag staan → daarna EXPIRED.
AI_WORKER_QUEUE_TTL_MS=60000
# Hoe lang de claim-endpoint (long-poll) op een job wacht voordat hij 204 teruggeeft (0 = niet wachten).
AI_WORKER_CLAIM_LONGPOLL_MS=20000
# Poll-interval (ms) voor het wachten op een resultaat en de long-poll-claim.
AI_WORKER_POLL_INTERVAL_MS=250
# Rate limiting op de worker-endpoints (per IP).
AI_WORKER_RATE_LIMIT_MAX=600
AI_WORKER_RATE_LIMIT_WINDOW_MINUTES=1

# --- Kandidatenselectie en nieuwe concepten (T10.2/T10.6, DESIGN §7.3, §7.6, ADR-0012) ---
# Maximum aantal AAC-kandidaten dat per beurt aan de AI wordt voorgelegd. De kandidaten komen niet uit
# één tak van de begrippenboom maar uit retrieval over de héle bibliotheek (boomkinderen + kleinkinderen
# + zoekindex + geleerde voorkeuren). Hoger = de AI heeft meer ruimte om te achterhalen wat de gebruiker
# bedoelt, maar grotere prompts (latency/kosten).
AI_MAX_CANDIDATES=30
# Of de AI tijdens een gesprek een begrip mag aandragen dat nog niet in de bibliotheek staat.
# `true` (standaard): staat het woord van de gebruiker er niet in, dan maakt de backend het aan als
# gemarkeerd "nieuw woord" (met automatisch gezocht pictogram) en legt het ter beoordeling voor aan de
# beheerder — zonder deze uitweg zit de gebruiker vast in andermans woordenschat.
# `false`: de bibliotheek is hard begrenzend; een onbekend begrip bereikt de gebruiker nooit en blijft
# alleen een conceptvoorstel. Deduplicatie tegen bestaande concepten/synoniemen gaat altijd voor.
AI_ALLOW_NEW_CONCEPTS=true

# --- Spraakuitvoer (T18.1, DESIGN §5.3, §9.2, §9.4) ---
# De tablet laat uitspreken wat er op zijn scherm staat; de backend praat namens hem met de
# spraakdienst uit `speech-service/` (Piper, lokaal — de zin van de gebruiker gaat nooit naar een
# cloudleverancier). Zie docs/adr/0015-speech-synthesis-piper.md.
# `none` (standaard): geen spraakdienst; de spraakendpoints antwoorden met 503 SPEECH_UNAVAILABLE en
# de tablet valt terug op de stem van het apparaat zelf. `http`: de dienst hieronder.
SPEECH_PROVIDER=none
# Basis-URL van de spraakdienst. Verplicht bij SPEECH_PROVIDER=http; in productie https.
SPEECH_SERVICE_URL=
# Gedeeld geheim (Bearer) waarmee de backend zich bij die dienst meldt — hetzelfde als SERVICE_TOKEN
# in speech-service/.env. Leeg = geen controle; alleen verdedigbaar op localhost.
SPEECH_SERVICE_TOKEN=
# Time-out (ms) voor één synthese-aanroep. Piper doet een zin in ± 100 ms; dit is de noodrem.
SPEECH_TIMEOUT_MS=10000
# Aantal fragmenten in de geheugencache (sleutel: hash van tekst + stem). Alleen in het geheugen:
# audio van wat de gebruiker zei wordt nooit opgeslagen. 0 = niet cachen.
SPEECH_CACHE_MAX_ENTRIES=500
# Rate limiting op de spraakendpoints (per IP).
SPEECH_RATE_LIMIT_MAX=120
SPEECH_RATE_LIMIT_WINDOW_MINUTES=1

# --- Seed (alleen voor `npm run db:seed`) ---
# Eerste ADMIN-account. Overschrijf het wachtwoord buiten lokale ontwikkeling.
SEED_ADMIN_EMAIL=admin@intento.local
SEED_ADMIN_PASSWORD=change-me-admin

# --- Secrets (prod-guard: server weigert te starten in productie met deze defaults) ---
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SIGNING_SECRET ondertekent sessie-cookies (vanaf T1.1).
SIGNING_SECRET=dev-only-change-me
# ENCRYPTION_KEY versleutelt gevoelige velden at-rest (vanaf T6.1).
ENCRYPTION_KEY=dev-only-change-me-32-bytes-hex

# --- Web-app (Vite, T2.1) ---
# Hoort in web/.env (of als shell-var bij de build). Basis-URL van de backend-API die de
# web-app aanspreekt. Standaard http://localhost:3000; zet dit op de publieke API-URL in prod.
# VITE_API_URL=http://localhost:3000
