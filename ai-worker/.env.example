# ── Intento Ollama-worker (T5.6) — voorbeeldconfiguratie ──────────────────────────────────────────────
# Kopieer naar `.env` en vul in. Alle waarden mogen ook als echte omgevingsvariabelen worden gezet;
# directe env-vars winnen van dit bestand.

# Basis-URL van de Intento-backend (zonder pad). De worker plakt hier `/ai/worker/...` achter.
# Gebruik in productie https.
BACKEND_URL=http://localhost:3000

# Het worker-token (infrastructuur-credential, T5.5). Munt er één op de backend met:
#   npm run worker-token:create --workspace=server -- --name gpu-node-1
# Het rauwe token wordt daar één keer getoond; zet het hier neer.
WORKER_TOKEN=

# Ollama-endpoint (mag op een andere machine draaien) en het te gebruiken model.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Maximum aantal gelijktijdige Ollama-aanroepen. Begrenst de threadpool én het claimen, zodat de worker
# Ollama (en daarmee de site) niet overvraagt. Kies dit op de capaciteit van de Ollama-machine.
MAX_THREADS=2

# Time-out (s) voor één Ollama-aanroep; een hangende inferentie blokkeert de worker niet.
OLLAMA_TIMEOUT_S=120

# Client-time-out (s) voor de long-poll-claim. Moet ruim boven de server-long-poll liggen
# (AI_WORKER_CLAIM_LONGPOLL_MS, standaard 20 s), anders breekt de claim voortijdig af.
CLAIM_TIMEOUT_S=30

# Interval (s) tussen heartbeats tijdens lange inferentie. Moet ruim onder de server-lease liggen
# (AI_WORKER_LEASE_MS, standaard 30 s), anders verloopt de lease en wordt de job teruggelegd.
HEARTBEAT_INTERVAL_S=10

# Pauze (s) na een lege claim (204) voordat opnieuw wordt geprobeerd.
IDLE_SLEEP_S=1
