# Agentdienst (INTENTO-NEW-DESIGN §3.1) — kopieer naar .env en vul in.

# Waar de dienst luistert. Standaard alleen localhost: de Intento-backend is de enige beller. In
# compose luistert hij op 0.0.0.0, maar zonder poort naar buiten.
HOST=127.0.0.1
PORT=5003

# Gedeeld geheim tussen deze dienst en de backend — VERPLICHT, minstens 16 tekens. Verzin het zelf:
#   python -c "import secrets; print('agt_' + secrets.token_hex(24))"
# Zet dezelfde waarde in server/.env als AGENT_SERVICE_TOKEN; lopen ze uiteen, dan krijgt de backend
# een 401. Mag ook als AGENT_SERVICE_TOKEN in dit bestand staan. GET /health vraagt nooit een token.
SERVICE_TOKEN=
