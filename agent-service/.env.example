# Agentdienst (INTENTO-NEW-DESIGN §3.1) — kopieer naar .env en vul in.

# Waar de dienst luistert. Standaard alleen localhost: de Intento-backend is de enige beller. In
# compose luistert hij op 0.0.0.0, maar zonder poort naar buiten.
HOST=127.0.0.1
PORT=5003

# Gedeeld geheim tussen deze dienst en de backend — VERPLICHT, minstens 16 tekens. Verzin het zelf:
#   python -c "import secrets; print('agt_' + secrets.token_hex(24))"
# Zet dezelfde waarde in server/.env als AGENT_SERVICE_TOKEN; lopen ze uiteen, dan krijgt de backend
# een 401. Mag ook als AGENT_SERVICE_TOKEN in dit bestand staan. GET /health vraagt nooit een token.
SERVICE_TOKEN=

# --- Taalmodel (INTENTO-NEW-DESIGN §35) ---
# LEEG = geen LLM: alle agents draaien op hun regels (werkt altijd, minder slim).
# Twee manieren om een cloudmodel te gebruiken:
#  - via de lokale Ollama (aangemeld bij ollama.com): http://127.0.0.1:11434 met een `-cloud`-model;
#  - rechtstreeks: https://ollama.com met OLLAMA_API_KEY en de modelnaam zonder `-cloud`.
OLLAMA_URL=
# Welk model, bv. gpt-oss:120b-cloud (via de lokale Ollama) of gpt-oss:120b (rechtstreeks). Verplicht
# zodra OLLAMA_URL gezet is. Let op: Ollama trekt cloudmodellen soms in (HTTP 410 "retired").
OLLAMA_MODEL=
# Alleen voor Ollama Cloud: de API-key (Bearer). Gaat uitsluitend over https; de dienst weigert te
# starten met een sleutel bij een http-URL. Let op: bij de cloud verlaten concepten, vragen en antwoorden
# de eigen omgeving — nooit namen of e-mailadressen van contacten (zie docs/security.md).
OLLAMA_API_KEY=
