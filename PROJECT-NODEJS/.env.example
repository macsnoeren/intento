# Voorbeeld-omgevingsvariabelen. Kopieer naar .env en vul in.
# NOOIT echte secrets committen. Houd dit bestand gelijk met src/env.ts.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database ---
# SQLite (nul-installatie): file:./dev.db  |  PostgreSQL: postgresql://user:pass@host:5432/db
DATABASE_URL=file:./dev.db

# --- Secrets (prod-guard: app weigert te starten in productie met deze defaults) ---
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=dev-only-change-me
ENCRYPTION_KEY=dev-only-change-me-32-bytes-hex

# --- Netwerk ---
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false        # true in productie (HTTPS)
TRUST_PROXY=false          # achter reverse proxy: aantal hops, bijv. 1

# --- Limieten ---
MAX_UPLOAD_MB=1024
