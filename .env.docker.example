# Compose-omgeving voor Intento (fase 19). Kopieer naar `.env.docker` en vul in.
# Dit bestand hoort NOOIT in git: het bevat de geheimen van je omgeving.

# --- Poorten op de host ---------------------------------------------------------------------------
# De API en de web-app hebben elk een eigen poort. De web-app praat vanuit de browser met de API, dus
# VITE_API_URL moet kloppen met SERVER_PORT zoals jouw browser hem bereikt.
SERVER_PORT=3000
WEB_PORT=8080
VITE_API_URL=http://localhost:3000

# --- Backend --------------------------------------------------------------------------------------
# Waar de browser de web-app bereikt; de backend accepteert alleen deze herkomst (CORS).
CORS_ORIGIN=http://localhost:8080
# Links in e-mails wijzen hierheen.
APP_BASE_URL=http://localhost:8080
EMAIL_VERIFICATION_URL_BASE=http://localhost:8080/verify-email

# Geheimen — genereer echte waarden, de app weigert in productie met de dev-defaults te starten:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=
ENCRYPTION_KEY=
# Ondertekent de afbeeldings-URL's van de Vocabulary (eigen waarde, niet hergebruiken).
ASSET_URL_SECRET=

# `Secure`-cookies vereisen HTTPS. Op een lokale http://localhost-opstelling moet dit false blijven,
# anders komt de sessiecookie niet aan. Achter TLS: true.
COOKIE_SECURE=false
# Welke proxy's vóór de app het client-IP (X-Forwarded-For) mogen bepalen. Wijs ze aan op
# ADRES; een aantal hops is geen geldige waarde meer (die vorm viel te misleiden en is uit
# fastify verwijderd). Kies:
#   false        geen proxy — het adres van de verbinding is het client-IP. Standaard.
#   uniquelocal  de privéranges. Dit wil je achter een reverse proxy in hetzelfde
#                container-/privénetwerk, met geen poort van buitenaf op de app.
#   loopback     alleen 127.0.0.1/::1.
#   true         alles vertrouwen — alleen als niets buiten de proxy de app kan bereiken.
#   of een IP, CIDR of komma-gescheiden lijst, bv. 172.18.0.0/16
TRUST_PROXY=false

# De prod-guard in `env.ts` eist bij `production`: https voor APP_BASE_URL, EMAIL_VERIFICATION_URL_BASE
# en SPEECH_SERVICE_URL, `COOKIE_SECURE=true`, een echte mailserver en geen dev-default-secrets. Op een
# lokale http://localhost-stack kan dat niet, dus dan hoort hier `development` te staan — de server
# weigert anders (terecht) te starten. Zet dit op `production` zodra er TLS vóór staat.
NODE_ENV=development

# --- E-mail ---------------------------------------------------------------------------------------
# Twee schrijfwijzen, kies er één (allebei invullen = de app weigert te starten).
#
# De losse velden, zoals je hostingpakket ze opgeeft — geen percent-codeergedoe met het
# wachtwoord. SMTP_SECURE is 'tls' (STARTTLS, poort 587), 'ssl' (poort 465) of 'none' (poort 25,
# alleen zonder SMTP_USER). Laat SMTP_PORT leeg om de poort uit SMTP_SECURE te laten volgen.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
# Of alles in één string, bv. smtps://user%40jouwdomein.nl:pass@smtp.host:465.
SMTP_URL=
# Allebei leeg = mails worden alleen gelogd (geen mailserver nodig). Buiten dev hoort er één van
# de twee te staan.
MAIL_FROM=Intento <no-reply@intento.local>

# --- Spraakuitvoer (T19.2) ------------------------------------------------------------------------
# Gedeeld geheim tussen backend en spraakdienst. Verzin het zelf en houd beide kanten gelijk:
#   python -c "import secrets; print('spr_' + secrets.token_hex(24))"
# In compose is dit verplicht: de dienst luistert daar op alle interfaces van het containernetwerk.
SPEECH_SERVICE_TOKEN=
# --- Agentdienst (N1.7) ---------------------------------------------------------------------------
# Gedeeld geheim tussen backend en agentdienst (minstens 16 tekens). Verzin het zelf:
#   python -c "import secrets; print('agt_' + secrets.token_hex(24))"
# Compose geeft het aan beide kanten door (AGENT_SERVICE_TOKEN in de backend, SERVICE_TOKEN in de dienst).
AGENT_SERVICE_TOKEN=
# Hoe lang de backend op één beurt wacht (ms, max 120000); daarna "Even geen hulp" op de tablet.
AGENT_TIMEOUT_MS=30000
# Het taalmodel voor de agents (§35). Leeg = alleen de regelgebaseerde agents.
# Ollama op de host vanuit een container: http://host.docker.internal:11434 (Linux: voeg dan
# `extra_hosts: ["host.docker.internal:host-gateway"]` toe), of Ollama Cloud: https://ollama.com.
OLLAMA_URL=
OLLAMA_MODEL=
# Alleen voor Ollama Cloud (Bearer, alleen over https).
OLLAMA_API_KEY=
# Vanaf welke zekerheid (0,5–1) de agents "Bedoel je …?" voorstellen. Standaard 0.85.
AGENT_PROPOSE_THRESHOLD=0.85
# Laat het model ook elke vraag keuren (extra aanroep per vraag). Standaard false.
AGENT_LLM_VALIDATION=false
# Laat het model ook beoordelen of een vraag passend en niet belastend is. Standaard false.
AGENT_LLM_SAFETY=false
# Tijdsbudget per beurt in de agentdienst (s); ruim onder AGENT_TIMEOUT_MS houden. Standaard 25.
AGENT_TURN_BUDGET_SECONDS=25

# Welke stemmen de init-dienst naar het volume haalt (spaties ertussen). Zie de catalogus in
# `shared/src/index.ts`; ± 63 MB per stem.
SPEECH_VOICES=nl_NL-pim-medium nl_NL-alex-medium nl_NL-ronnie-medium nl_BE-nathalie-medium

# --- Vocabulary (N8.3) ------------------------------------------------------------------------------
# Welke licentiefamilies een geïmporteerd symbool mag hebben (komma's). Standaard CC0,CC-BY,CC-BY-SA.
VOCABULARY_ALLOWED_LICENSES=CC0,CC-BY,CC-BY-SA
