# Spraakdienst (T18.1) — kopieer naar .env en vul in.

# Waar de dienst luistert. Standaard alleen localhost: de Intento-backend hoort de enige beller te
# zijn. Zet HOST=0.0.0.0 alleen als de dienst op een andere machine draait dan de backend — en zet
# er dan ook een SERVICE_TOKEN op.
HOST=127.0.0.1
PORT=5002

# Map met de Piper-stemmodellen (<naam>.onnx + <naam>.onnx.json).
VOICES_DIR=voices

# Gedeeld geheim tussen deze dienst en de backend — verzin het zelf, er geeft niemand het uit:
#   python -c "import secrets; print('spr_' + secrets.token_hex(24))"
# Zet dezelfde waarde in server/.env als SPEECH_SERVICE_TOKEN; lopen ze uiteen, dan krijgt de backend
# een 401. Leeg = geen controle (en de backend stuurt dan ook geen header); alleen verdedigbaar
# zolang HOST op 127.0.0.1 staat. GET /health vraagt nooit een token.
SERVICE_TOKEN=

# Bovengrens op de tekstlengte. Houd dit gelijk aan SPEECH_MAX_TEXT_LENGTH in de gedeelde schema's.
MAX_TEXT_LENGTH=300
